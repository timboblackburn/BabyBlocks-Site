---
import AbstractGlow from './abstract/AbstractGlow.astro';

interface Props {
  heading?: string;
  subheading?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  heading = 'One email when BudgetBaby is back.',
  subheading = 'The new LLC build is in App Review. We will email you the day it goes live.',
  primaryLabel = 'Join the waitlist',
  primaryHref = '/budgetbaby#bb-waitlist',
  secondaryLabel = 'See the features',
  secondaryHref = '/budgetbaby/features',
} = Astro.props;
---

<section class="cta-section section-sm">
  <div class="container">
    <div class="cta-card glass-accent">
      <AbstractGlow tone="coral" size="lg" opacity={0.22}
                    position="top:50%;left:50%;transform:translate(-50%,-50%);" />
      <div class="cta-content">
        <h2>{heading}</h2>
        <p>{subheading}</p>
        <div class="cta-actions">
          <a href={primaryHref} class="btn btn-primary btn-lg">
            {primaryLabel}
          </a>
          {secondaryLabel && (
            <a href={secondaryHref} class="btn btn-secondary btn-lg">
              {secondaryLabel}
            </a>
          )}
        </div>
        <p class="cta-note">iOS 17+. Free tier available. Premium from $7.99/mo.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section { padding-block: var(--space-16); }

  .cta-card {
    position: relative;
    overflow: hidden;
    padding: var(--space-16) var(--space-12);
    text-align: center;
    border-radius: var(--radius-2xl);
  }

  .cta-content {
    position: relative;
    z-index: 1;
  }

  .cta-content h2 {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-4);
  }

  .cta-content p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 48ch;
    margin-inline: auto;
    margin-bottom: var(--space-8);
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .cta-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .cta-card { padding: var(--space-10) var(--space-6); }
    .cta-actions { flex-direction: column; align-items: stretch; }
    .cta-actions .btn { text-align: center; }
  }
</style>
