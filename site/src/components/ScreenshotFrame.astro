---
interface Props {
  caption: string;
  label?: string;
}
const { caption, label } = Astro.props;
---
<div class="screenshot-frame">
  {label && <div class="screenshot-label">{label}</div>}
  <div class="screenshot-device">
    <div class="screenshot-chrome">
      <div class="screenshot-notch"></div>
    </div>
    <div class="screenshot-screen">
      <slot />
    </div>
  </div>
  <p class="screenshot-caption">{caption}</p>
</div>

<style>
  .screenshot-frame {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .screenshot-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-deep);
  }

  .screenshot-device {
    width: 200px;
    height: 420px;
    background: #131217;
    border-radius: 36px;
    border: 1px solid rgba(38, 33, 28, 0.12);
    box-shadow: var(--shadow-card-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .screenshot-chrome {
    height: 44px;
    background: #0F0E14;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid rgba(255, 247, 239, 0.06);
  }

  .screenshot-notch {
    width: 72px;
    height: 20px;
    background: #131217;
    border-radius: 12px;
  }

  .screenshot-screen {
    flex: 1;
    overflow: hidden;
    background: #131217;
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);

    /* Light-on-dark context for any tokenised child content. */
    --text-primary:   #FFF7EF;
    --text-secondary: rgba(255, 247, 239, 0.78);
    --text-muted:     rgba(255, 247, 239, 0.55);
    --text-faint:     rgba(255, 247, 239, 0.40);
    --glass-border:   rgba(255, 247, 239, 0.08);
    color: #FFF7EF;
  }

  .screenshot-caption {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-align: center;
    max-width: 18ch;
    line-height: var(--leading-relaxed);
    margin: 0;
  }
</style>
