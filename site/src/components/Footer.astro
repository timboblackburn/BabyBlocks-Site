---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src="/BabyBlocksIcon/favicon-48x48.png" alt="" width="22" height="22" class="footer-logo-mark" />
          <span>BabyBlocks</span>
        </a>
        <p class="footer-tagline">
          Calm iOS apps. One job each. Local-first by default.<br />
          A BabyBlocks-family project. Part of <a href="https://intriguinginsight.com" target="_blank" rel="noopener" class="footer-tagline-link">Intriguing Insight</a>. Operated by <a href="https://intriguemmc.com" target="_blank" rel="noopener" class="footer-tagline-link">Intrigue MMC LLC</a>.
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer navigation">
        <div class="footer-col">
          <h3 class="footer-col-title">BudgetBaby</h3>
          <ul class="footer-links">
            <li><a href="/budgetbaby">Overview</a></li>
            <li><a href="/budgetbaby/features">Features</a></li>
            <li><a href="/budgetbaby/docs">Documentation</a></li>
            <li><a href="/budgetbaby/support">Support</a></li>
            <li><a href="/budgetbaby/trust">Trust &amp; Privacy</a></li>
            <li><a href="/budgetbaby/privacy">Privacy Policy</a></li>
            <li><a href="/budgetbaby/terms">Terms of Use</a></li>
            <li><a href="/budgetbaby/delete-data">Delete Your Data</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-col-title">Ecosystem</h3>
          <ul class="footer-links">
            <li><a href="/coming-soon">Coming Soon</a></li>
            <li><a href="/coming-soon/roadmap">Roadmap</a></li>
            <li><a href="/changelog">Changelog</a></li>
            <li><a href="/status">Status</a></li>
            <li><a href="/security">Security</a></li>
            <li><a href="/data-request">Data request</a></li>
            <li><a href="/about">About BabyBlocks</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-col-title">Contact</h3>
          <ul class="footer-links">
            <li><a href="mailto:support@babyblocks.io">support@babyblocks.io</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <!-- Family rail. Identical block on every site in the Intrigue MMC family
         so the four properties read as one studio with four brands. -->
    <div class="family-rail">
      <p class="family-rail-label">Part of Intrigue MMC LLC</p>
      <ul class="family-rail-list">
        <li><a href="https://intriguemmc.com" target="_blank" rel="noopener" class="family-rail-link">Intrigue MMC <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://intriguinginsight.com" target="_blank" rel="noopener" class="family-rail-link">Intriguing Insight <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://foundry-os.io" target="_blank" rel="noopener" class="family-rail-link">Foundry <span aria-hidden="true">↗</span></a></li>
        <li><span class="family-rail-link family-rail-soon">ScreenForge</span></li>
      </ul>
      <a href="https://intriguemmc.com/press" target="_blank" rel="noopener" class="family-rail-press">Press kit <span aria-hidden="true">→</span></a>
    </div>

    <div class="footer-bottom">
      <p class="footer-legal">
        &copy; {year} Intrigue MMC LLC. All rights reserved. Illinois LLC. Founded 2024.
      </p>
      <div class="footer-legal-links">
        <a href="/budgetbaby/privacy">Privacy</a>
        <span aria-hidden="true">·</span>
        <a href="/budgetbaby/terms">Terms</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--glass-border);
    background: var(--bg-raised);
    margin-top: var(--space-24);
  }

  .footer-inner { padding-block: var(--space-16) var(--space-8); }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-16);
    margin-bottom: var(--space-12);
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }
  .footer-tagline-link {
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }
  .footer-tagline-link:hover { color: var(--accent-light); }
  .footer-logo-mark {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: block;
  }

  .family-rail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    padding: var(--space-5) 0;
    border-top: 1px solid var(--glass-border);
    margin-top: var(--space-8);
  }
  .family-rail-label {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: var(--weight-semibold);
    color: var(--accent-light);
    margin: 0;
  }
  .family-rail-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }
  .family-rail-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    transition: color 0.15s ease;
  }
  .family-rail-link:hover { color: var(--accent-light); }
  .family-rail-soon { color: var(--text-faint); cursor: default; }
  .family-rail-press {
    color: var(--accent-light);
    text-decoration: none;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: var(--weight-semibold);
    transition: color 0.15s ease;
  }
  .family-rail-press:hover { color: var(--text-primary); }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .footer-col-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover { color: var(--text-primary); }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    border-top: 1px solid var(--glass-border);
    gap: var(--space-4);
  }

  .footer-legal, .footer-legal-links {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-legal-links a {
    color: var(--text-faint);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-legal-links a:hover { color: var(--text-muted); }

  @media (max-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8) var(--space-6);
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }

  @media (max-width: 480px) {
    .footer-nav { grid-template-columns: 1fr; }
  }
</style>
