---
/**
 * ProductAura
 * Background wash for a product card. One named variant per family
 * brand so each app feels related but not identical.
 *
 *  - babyblocks:  warm cream / blush pastel
 *  - intrigue:    indigo + violet abstract wave (parent studio)
 *  - insight:     dark editorial atmosphere with a single light beam
 *  - foundry:     dark metallic with a subtle grid
 *  - screenforge: violet UI panel glow
 *
 * Always sits inside a positioned parent (e.g. a card). aria-hidden:
 * decorative only.
 *
 * Props
 *  - variant: babyblocks | intrigue | insight | foundry | screenforge
 *  - intensity: 0..1 — global opacity dial (default: 0.9)
 */
interface Props {
  variant?: 'babyblocks' | 'intrigue' | 'insight' | 'foundry' | 'screenforge';
  intensity?: number;
  class?: string;
}

const {
  variant = 'babyblocks',
  intensity = 0.9,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['product-aura', `pa-${variant}`, className]}
  style={`--pa-intensity:${intensity}`}
  aria-hidden="true"
>
  {variant === 'foundry' && (
    <svg class="pa-grid" viewBox="0 0 200 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <pattern id="pa-foundry-grid" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <path d="M20 0H0V20" fill="none" stroke="rgba(255,247,239,0.06)" stroke-width="1" />
        </pattern>
      </defs>
      <rect x="0" y="0" width="100%" height="100%" fill="url(#pa-foundry-grid)" />
    </svg>
  )}

  {variant === 'insight' && (
    <span class="pa-beam" />
  )}

  {variant === 'intrigue' && (
    <svg class="pa-wave" viewBox="0 0 240 200" preserveAspectRatio="none" aria-hidden="true">
      <path
        d="M0,120 C40,90 80,60 120,80 C160,100 200,140 240,110 L240,200 L0,200 Z"
        fill="rgba(124, 58, 237, 0.18)"
      />
      <path
        d="M0,140 C40,120 90,90 130,110 C170,130 210,160 240,135 L240,200 L0,200 Z"
        fill="rgba(91, 91, 255, 0.14)"
      />
    </svg>
  )}
</div>

<style>
  .product-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
    opacity: var(--pa-intensity);
  }

  /* BabyBlocks — warm cream / blush + a soft peach bloom. Reads paper-like. */
  .pa-babyblocks {
    background:
      radial-gradient(ellipse 90% 70% at 100% 0%, rgba(255, 184, 199, 0.45) 0%, transparent 60%),
      radial-gradient(ellipse 60% 60% at 0% 100%, rgba(255, 217, 191, 0.40) 0%, transparent 65%),
      linear-gradient(165deg, #FFF7EF 0%, #FBEFE3 100%);
  }

  /* Intrigue — parent studio. Cool indigo wash with the wave SVG layered above. */
  .pa-intrigue {
    background: linear-gradient(160deg, #0E0E16 0%, #161324 60%, #0F0E18 100%);
  }
  .pa-wave {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  /* Insight — book-like atmosphere. Single warm beam from upper-right. */
  .pa-insight {
    background:
      radial-gradient(ellipse 50% 40% at 90% 5%, rgba(167, 139, 250, 0.30) 0%, transparent 55%),
      linear-gradient(180deg, #0B0A12 0%, #100E1A 100%);
  }
  .pa-beam {
    position: absolute;
    top: -10%;
    right: 8%;
    width: 80%;
    height: 140%;
    background: linear-gradient(165deg, rgba(255, 247, 239, 0.06) 0%, transparent 35%);
    transform: rotate(-18deg);
    transform-origin: top right;
    pointer-events: none;
  }

  /* Foundry — dark metallic with the grid SVG (engineered, restrained). */
  .pa-foundry {
    background:
      radial-gradient(ellipse 80% 50% at 70% 100%, rgba(91, 91, 255, 0.22) 0%, transparent 60%),
      linear-gradient(170deg, #0A0A12 0%, #14141E 100%);
  }
  .pa-grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* ScreenForge — violet UI panel glow. */
  .pa-screenforge {
    background:
      radial-gradient(ellipse 60% 60% at 50% 0%, rgba(167, 139, 250, 0.32) 0%, transparent 65%),
      radial-gradient(ellipse 70% 50% at 50% 100%, rgba(124, 58, 237, 0.28) 0%, transparent 60%),
      linear-gradient(180deg, #110D1E 0%, #1A1230 100%);
  }
</style>
