---
import GlassCard from './GlassCard.astro';

export interface Props {
  app: 'budgetbaby' | 'pantrybaby' | 'babyblocks-core';
  heading?: string;
  sub?: string;
  fallbackMailto?: string;
}

const {
  app,
  heading = 'Get notified at launch.',
  sub = 'No spam. One email when we go live on the App Store.',
  fallbackMailto = 'contact@intriguinginsight.com',
} = Astro.props;

const formId = `waitlist-form-${app}`;

// FoundryDesk public waitlist endpoint. Default points at the production
// CRM under the `intriguinginsight` brand (the studio that publishes the
// BabyBlocks family). Override at build time with PUBLIC_WAITLIST_URL if
// you need to hit staging or a different brand slug.
//
// FoundryDesk dedupes by email+brand, stores position + joinedAt + ipHash
// in payload.waitlist, fires `lead.captured`, and emails the founder.
// No bearer token required; rate-limited per-IP, 6 reqs/60s per brand.
// Honeypot + render-timestamp included in the body for spam scoring.
const waitlistUrl =
  import.meta.env.PUBLIC_WAITLIST_URL ??
  'https://crm.intriguemmc.com/api/waitlist/intriguinginsight';

// Timestamp the moment the page rendered. FoundryDesk uses the gap
// between this and the submit time as one of its spam signals.
const renderedAt = Date.now();
---

<GlassCard padding="md">
  <form id={formId} class="waitlist-form" data-app={app} data-rendered-at={renderedAt} novalidate>
    <h2 class="waitlist-heading">{heading}</h2>
    <p class="waitlist-sub">{sub}</p>

    <div class="waitlist-fields">
      <input
        type="text"
        name="name"
        placeholder="First name"
        autocomplete="given-name"
        required
        class="waitlist-input"
        aria-label="First name"
      />
      <input
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
        class="waitlist-input"
        aria-label="Email"
      />
      <button type="submit" class="btn btn-primary waitlist-submit">
        <span class="waitlist-submit-label">Notify me</span>
        <span class="waitlist-submit-spinner" aria-hidden="true"></span>
      </button>
    </div>

    {/* Honeypot. Real users never see or fill this; bots usually do. */}
    <input
      type="text"
      name="company"
      tabindex="-1"
      autocomplete="off"
      class="waitlist-honeypot"
      aria-hidden="true"
    />

    <p class="waitlist-status" aria-live="polite"></p>

    <p class="waitlist-fallback">
      Prefer email? Drop a note to <a href={`mailto:${fallbackMailto}?subject=Waitlist:%20${app}`}>{fallbackMailto}</a>
      and we'll add you manually.
    </p>
  </form>
</GlassCard>

<script is:inline define:vars={{ formId, waitlistUrl, fallbackMailto }}>
  // Self-contained vanilla JS, no framework, runs once per form on the page.
  // Posts to FoundryDesk's public waitlist endpoint at
  // /api/waitlist/intriguinginsight. FoundryDesk dedupes by lowercase
  // email, stores the product (BudgetBaby / PantryBaby / etc.) in
  // payload.productName, fires lead.captured for automations, and emails
  // the founder. Honeypot + render-timestamp included for spam scoring.
  const form = document.getElementById(formId);
  if (form) {
    const status = form.querySelector('.waitlist-status');
    const submit = form.querySelector('.waitlist-submit');
    const label = form.querySelector('.waitlist-submit-label');
    const spinner = form.querySelector('.waitlist-submit-spinner');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      status.className = 'waitlist-status';

      const fd = new FormData(form);
      const app = form.dataset.app;
      const renderedAt = Number(form.dataset.renderedAt || Date.now());
      const name = (fd.get('name') || '').toString().trim();
      const email = (fd.get('email') || '').toString().trim().toLowerCase();
      const hp = (fd.get('company') || '').toString().trim();

      if (!name || !email || !email.includes('@') || !email.includes('.')) {
        status.textContent = 'Please enter a name and a valid email.';
        status.classList.add('waitlist-status--error');
        return;
      }

      // Map the internal app slug to a clean display name. The display
      // name lands in the founder's email notification from FoundryDesk.
      const productName = app === 'budgetbaby'
        ? 'BudgetBaby'
        : app === 'pantrybaby'
          ? 'PantryBaby'
          : 'BabyBlocks Core';

      submit.disabled = true;
      label.style.opacity = '0.4';
      spinner.classList.add('is-spinning');

      try {
        const res = await fetch(waitlistUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            name,
            _hp: hp,
            _t: renderedAt,
            payload: {
              productName,
              productSlug: app,
              source: 'babyblocks-waitlist',
              path: location.pathname,
            },
          }),
        });
        if (res.status === 429) throw new Error('rate');
        if (!res.ok) throw new Error('HTTP ' + res.status);

        form.reset();
        status.textContent = "You're on the list. We'll email " + email + " the moment " + productName + " is live.";
        status.classList.add('waitlist-status--success');
        try {
          if (typeof window.plausible === 'function') {
            window.plausible('waitlist_signup', { props: { app: app } });
          }
        } catch (_) { /* analytics never breaks UX */ }
      } catch (err) {
        status.innerHTML = "Couldn't reach our servers right now. Email us at <a href=\"mailto:" + fallbackMailto + "?subject=Waitlist:%20" + app + "\">" + fallbackMailto + "</a> and we'll add you manually.";
        status.classList.add('waitlist-status--error');
        try {
          if (typeof window.plausible === 'function') {
            window.plausible('waitlist_signup_error', { props: { app: app } });
          }
        } catch (_) { /* swallow */ }
      } finally {
        submit.disabled = false;
        label.style.opacity = '1';
        spinner.classList.remove('is-spinning');
      }
    });
  }
</script>

<style>
  .waitlist-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .waitlist-heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0;
    color: var(--text-primary);
  }

  .waitlist-sub {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0 0 0.5rem 0;
  }

  .waitlist-fields {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 0.5rem;
  }

  @media (max-width: 720px) {
    .waitlist-fields {
      grid-template-columns: 1fr;
    }
  }

  .waitlist-input {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--glass-border-strong, rgba(21, 17, 13, 0.14));
    border-radius: 0.7rem;
    padding: 0.75rem 0.85rem;
    color: var(--text-primary);
    font-size: 1rem;
    width: 100%;
    transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }

  .waitlist-input::placeholder {
    color: var(--text-muted);
  }

  .waitlist-input:focus {
    outline: none;
    border-color: var(--accent, #F25E72);
    background: #FFFFFF;
    box-shadow: 0 0 0 3px rgba(242, 94, 114, 0.16);
  }

  .waitlist-submit {
    position: relative;
    min-width: 7.5rem;
    white-space: nowrap;
  }

  .waitlist-submit:disabled {
    cursor: wait;
  }

  .waitlist-submit-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 1rem;
    height: 1rem;
    margin-top: -0.5rem;
    margin-left: -0.5rem;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .waitlist-submit-spinner.is-spinning {
    opacity: 1;
    animation: waitlist-spin 0.75s linear infinite;
  }

  @keyframes waitlist-spin {
    to { transform: rotate(360deg); }
  }

  .waitlist-status {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 0;
    min-height: 1.25rem;
  }

  .waitlist-status--error { color: #e87474; }
  .waitlist-status--success { color: #6fcf97; }

  .waitlist-fallback {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0 0;
  }

  .waitlist-fallback a {
    color: var(--text-secondary);
    text-decoration: underline;
  }

  /* Honeypot: invisible to humans, irresistible to bots. */
  .waitlist-honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>
