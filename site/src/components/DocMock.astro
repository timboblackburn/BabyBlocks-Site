---
interface Props {
  caption?: string;
  label?: string;
  size?: 'sm' | 'md';
}
const { caption, label, size = 'md' } = Astro.props;
---
<figure class:list={['doc-mock', `doc-mock-${size}`]}>
  {label && <div class="doc-mock-label">{label}</div>}
  <div class="doc-mock-device">
    <div class="doc-mock-bezel">
      <div class="doc-mock-screen">
        <div class="doc-mock-statusbar">
          <span class="dm-time">9:41</span>
          <span class="dm-notch" aria-hidden="true"></span>
          <span class="dm-status-icons" aria-hidden="true">
            <span class="dm-signal"></span>
            <span class="dm-wifi"></span>
            <span class="dm-battery"></span>
          </span>
        </div>
        <div class="doc-mock-content">
          <slot />
        </div>
      </div>
    </div>
  </div>
  {caption && <figcaption class="doc-mock-caption">{caption}</figcaption>}
</figure>

<style is:global>
  /* ── Device frame ─────────────────────────────────────────── */
  .doc-mock {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .doc-mock-label {
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-light);
  }

  .doc-mock-device {
    width: 234px;
    flex-shrink: 0;
  }
  .doc-mock-sm .doc-mock-device { width: 200px; }

  .doc-mock-bezel {
    background: linear-gradient(160deg, #1a1a26 0%, #0c0c14 100%);
    border-radius: 38px;
    padding: 7px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.7) inset,
      0 24px 60px -10px rgba(0, 0, 0, 0.6),
      0 0 60px -10px rgba(139, 92, 246, 0.18);
  }

  .doc-mock-screen {
    background: var(--bg-base, #0a0a14);
    border-radius: 32px;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    display: flex;
    flex-direction: column;
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.05);
    /* Re-bind text vars for the dark phone screen so dm-* children stay readable
       on light-themed docs pages. */
    --text-primary:   #F4F1EA;
    --text-secondary: rgba(244, 241, 234, 0.78);
    --text-muted:     rgba(244, 241, 234, 0.62);
    --text-faint:     rgba(244, 241, 234, 0.45);
    --accent-light:   #C4B5FD;
    color: var(--text-primary);
  }

  .doc-mock-statusbar {
    height: 24px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 18px 0;
    font-size: 9px;
    font-weight: 700;
    color: var(--text-primary);
    position: relative;
  }
  .dm-notch {
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 56px;
    height: 16px;
    background: #000;
    border-radius: 12px;
  }
  .dm-status-icons {
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .dm-signal,
  .dm-wifi,
  .dm-battery {
    display: block;
    background: var(--text-primary);
    opacity: 0.92;
  }
  .dm-signal { width: 9px; height: 7px; clip-path: polygon(0 100%, 100% 0, 100% 100%); }
  .dm-wifi { width: 9px; height: 7px; clip-path: polygon(0 100%, 100% 100%, 50% 0); }
  .dm-battery { width: 14px; height: 6px; border-radius: 1.5px; border: 1px solid var(--text-primary); background: transparent; position: relative; }
  .dm-battery::after { content: ''; position: absolute; inset: 1px; background: var(--text-primary); border-radius: 0.5px; width: 70%; }

  .doc-mock-content {
    flex: 1;
    padding: 8px 12px 4px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow: hidden;
    font-size: 9px;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .doc-mock-caption {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    max-width: 22ch;
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ── Layout helpers ──────────────────────────────────────── */
  .doc-mocks-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-block: var(--space-6);
  }
  .doc-mocks-side {
    display: grid;
    grid-template-columns: 1fr 240px;
    gap: var(--space-6);
    align-items: start;
    margin-block: var(--space-5);
  }
  .doc-mocks-side > .doc-mock { justify-self: center; }

  @media (max-width: 720px) {
    .doc-mocks-side { grid-template-columns: 1fr; }
    .doc-mocks-side > .doc-mock { order: -1; }
  }

  /* ── Atomic mock UI primitives ───────────────────────────── */
  .doc-mock-content .dm-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2px 2px 6px;
  }
  .dm-back {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--accent-light);
    font-size: 9px;
    font-weight: 600;
  }
  .dm-back::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    border-left: 1.4px solid currentColor;
    border-bottom: 1.4px solid currentColor;
    transform: rotate(45deg);
    margin-right: 2px;
  }
  .dm-bar-action {
    color: var(--accent-light);
    font-size: 9px;
    font-weight: 600;
  }
  .dm-bar-title {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .dm-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.1;
    margin-block: 4px 2px;
  }
  .dm-subtitle {
    font-size: 9px;
    color: var(--text-muted);
    margin-bottom: 2px;
  }
  .dm-h2 {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-primary);
    margin-top: 2px;
  }
  .dm-section-label {
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-top: 4px;
    padding: 0 2px;
  }
  .dm-help {
    font-size: 8.5px;
    color: var(--text-muted);
    line-height: 1.35;
    padding: 0 2px;
  }

  /* Cards */
  .dm-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 7px 9px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dm-card.dm-card-accent {
    background: linear-gradient(135deg, rgba(139,92,246,0.18), rgba(139,92,246,0.05));
    border-color: rgba(167,139,250,0.4);
  }
  .dm-card.dm-card-warn {
    border-color: rgba(249, 115, 22, 0.45);
    background: rgba(249, 115, 22, 0.08);
  }
  .dm-card.dm-card-error {
    border-color: rgba(248, 113, 113, 0.45);
    background: rgba(248, 113, 113, 0.08);
  }
  .dm-card.dm-card-good {
    border-color: rgba(52, 211, 153, 0.4);
    background: rgba(52, 211, 153, 0.08);
  }

  /* Hero amount */
  .dm-hero-amount {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--text-primary);
  }
  .dm-hero-amount.green { color: #34D399; }
  .dm-hero-amount.yellow { color: #FBBF24; }
  .dm-hero-amount.orange { color: #F97316; }
  .dm-hero-amount.red { color: #F87171; }
  .dm-hero-amount > .dm-cents { font-size: 16px; opacity: 0.7; font-weight: 700; }
  .dm-hero-label {
    font-size: 8.5px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-weight: 600;
  }
  .dm-hero-sub {
    font-size: 9px;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  /* Lines (key/value rows inside cards) */
  .dm-kv {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 9px;
    color: var(--text-secondary);
    padding: 1.5px 0;
  }
  .dm-kv strong { color: var(--text-primary); font-weight: 600; }
  .dm-kv .green { color: #34D399; }
  .dm-kv .red { color: #F87171; }
  .dm-kv .yellow { color: #FBBF24; }
  .dm-kv .muted { color: var(--text-muted); }
  .dm-kv-divider { height: 1px; background: rgba(255,255,255,0.06); margin: 2px 0; }

  /* Progress bar */
  .dm-bar-track {
    height: 4px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    overflow: hidden;
  }
  .dm-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #8B5CF6, #A78BFA);
    border-radius: 2px;
  }
  .dm-bar-fill.green { background: linear-gradient(90deg, #10B981, #34D399); }
  .dm-bar-fill.orange { background: linear-gradient(90deg, #F97316, #FB923C); }
  .dm-bar-fill.red { background: linear-gradient(90deg, #EF4444, #F87171); }

  /* Settings-style row */
  .dm-list { display: flex; flex-direction: column; }
  .dm-list .dm-row {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 9px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.06);
    border-bottom: none;
  }
  .dm-list .dm-row:first-child { border-top-left-radius: 9px; border-top-right-radius: 9px; }
  .dm-list .dm-row:last-child { border-bottom-left-radius: 9px; border-bottom-right-radius: 9px; border-bottom: 1px solid rgba(255,255,255,0.06); }

  .dm-row {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 9px;
  }
  .dm-row-label { font-size: 9.5px; color: var(--text-primary); flex: 1; }
  .dm-row-meta { font-size: 9px; color: var(--text-muted); }
  .dm-row-chevron {
    width: 5px;
    height: 5px;
    border-top: 1.3px solid var(--text-faint);
    border-right: 1.3px solid var(--text-faint);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* Icon disc */
  .dm-icon {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-size: 10px;
    font-weight: 700;
    color: white;
  }
  .dm-icon.cash      { background: linear-gradient(135deg, #34D399, #059669); }
  .dm-icon.debit     { background: linear-gradient(135deg, #60A5FA, #2563EB); }
  .dm-icon.credit    { background: linear-gradient(135deg, #F59E0B, #B45309); }
  .dm-icon.savings   { background: linear-gradient(135deg, #A78BFA, #7C3AED); }
  .dm-icon.bills     { background: linear-gradient(135deg, #F87171, #B91C1C); }
  .dm-icon.shop      { background: linear-gradient(135deg, #FBBF24, #B45309); }
  .dm-icon.food      { background: linear-gradient(135deg, #FB923C, #C2410C); }
  .dm-icon.gas       { background: linear-gradient(135deg, #34D399, #047857); }
  .dm-icon.bell      { background: linear-gradient(135deg, #A78BFA, #6D28D9); }
  .dm-icon.lock      { background: linear-gradient(135deg, #818CF8, #4338CA); }
  .dm-icon.upload    { background: linear-gradient(135deg, #38BDF8, #0369A1); }
  .dm-icon.star      { background: linear-gradient(135deg, #FBBF24, #92400E); }
  .dm-icon.support   { background: linear-gradient(135deg, #94A3B8, #475569); }
  .dm-icon.target    { background: linear-gradient(135deg, #F472B6, #BE185D); }
  .dm-icon.calendar  { background: linear-gradient(135deg, #818CF8, #4F46E5); }
  .dm-icon.shield    { background: linear-gradient(135deg, #34D399, #047857); }
  .dm-icon.danger    { background: linear-gradient(135deg, #F87171, #991B1B); }

  /* Toggle */
  .dm-toggle {
    width: 22px;
    height: 13px;
    background: rgba(255,255,255,0.15);
    border-radius: 9999px;
    position: relative;
    flex-shrink: 0;
  }
  .dm-toggle::after {
    content: '';
    position: absolute;
    top: 1.5px;
    left: 1.5px;
    width: 10px;
    height: 10px;
    background: white;
    border-radius: 50%;
    transition: transform 0.2s;
  }
  .dm-toggle.on { background: #34D399; }
  .dm-toggle.on::after { transform: translateX(9px); }
  .dm-toggle.purple.on { background: #A78BFA; }

  /* Pills/badges */
  .dm-pill {
    display: inline-flex;
    align-items: center;
    padding: 1px 6px;
    border-radius: 100px;
    font-size: 7.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .dm-pill.purple    { background: rgba(167, 139, 250, 0.2); color: #C4B5FD; border: 1px solid rgba(167,139,250,0.4); }
  .dm-pill.green     { background: rgba(52, 211, 153, 0.2); color: #6EE7B7; border: 1px solid rgba(52,211,153,0.4); }
  .dm-pill.yellow    { background: rgba(251, 191, 36, 0.2); color: #FCD34D; border: 1px solid rgba(251,191,36,0.4); }
  .dm-pill.red       { background: rgba(248, 113, 113, 0.2); color: #FCA5A5; border: 1px solid rgba(248,113,113,0.4); }
  .dm-pill.orange    { background: rgba(249, 115, 22, 0.2); color: #FDBA74; border: 1px solid rgba(249,115,22,0.4); }
  .dm-pill.muted     { background: rgba(255,255,255,0.06); color: var(--text-muted); border: 1px solid rgba(255,255,255,0.08); }

  /* Priority dot */
  .dm-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
  }
  .dm-dot.critical      { background: #F87171; }
  .dm-dot.important     { background: #FBBF24; }
  .dm-dot.discretionary { background: #34D399; }
  .dm-dot.buffer        { background: #94A3B8; }
  .dm-dot.cash          { background: #34D399; }
  .dm-dot.debit         { background: #60A5FA; }
  .dm-dot.credit        { background: #F59E0B; }
  .dm-dot.savings       { background: #A78BFA; }
  .dm-dot.purple        { background: #A78BFA; }

  /* Buttons */
  .dm-btn {
    display: block;
    text-align: center;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 9.5px;
    font-weight: 700;
  }
  .dm-btn-primary {
    background: linear-gradient(135deg, #8B5CF6, #6D28D9);
    color: white;
    box-shadow: 0 4px 12px -2px rgba(139, 92, 246, 0.4);
  }
  .dm-btn-secondary {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--text-primary);
  }
  .dm-btn-danger {
    background: rgba(248,113,113,0.15);
    border: 1px solid rgba(248,113,113,0.4);
    color: #FCA5A5;
  }
  .dm-btn-disabled {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.06);
    color: var(--text-faint);
  }

  /* Tab bar */
  .dm-tabbar {
    margin-top: auto;
    margin-inline: -12px;
    padding: 6px 8px 4px;
    border-top: 1px solid rgba(255,255,255,0.06);
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(20px);
  }
  .dm-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    font-size: 7px;
    color: var(--text-faint);
    font-weight: 600;
  }
  .dm-tab.active { color: var(--accent-light); }
  .dm-tab-icon {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: currentColor;
    opacity: 0.85;
    margin-bottom: 1px;
  }

  /* Chart bars */
  .dm-chart {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 3px;
    height: 50px;
    padding: 4px 2px 0;
  }
  .dm-chart-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    height: 100%;
    justify-content: flex-end;
  }
  .dm-chart-bar {
    width: 100%;
    background: linear-gradient(180deg, rgba(139,92,246,0.6), rgba(139,92,246,0.25));
    border-radius: 2px 2px 0 0;
    min-height: 5%;
  }
  .dm-chart-bar.active {
    background: linear-gradient(180deg, #A78BFA, #8B5CF6);
  }
  .dm-chart-label {
    font-size: 7.5px;
    color: var(--text-muted);
  }

  /* Ring (savings progress) */
  .dm-ring {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background:
      conic-gradient(#A78BFA var(--p, 50%), rgba(255,255,255,0.08) 0);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .dm-ring::after {
    content: '';
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--bg-base, #0a0a14);
  }
  .dm-ring-inner {
    position: absolute;
    font-size: 8.5px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .dm-ring-wrap {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Segmented control */
  .dm-seg {
    display: flex;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 7px;
    padding: 1.5px;
    gap: 1.5px;
  }
  .dm-seg-item {
    flex: 1;
    text-align: center;
    padding: 3px 4px;
    border-radius: 5px;
    font-size: 8.5px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .dm-seg-item.active {
    background: rgba(139, 92, 246, 0.4);
    color: white;
  }

  /* Notification card (push notif look) */
  .dm-notif {
    background: rgba(40, 40, 55, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 7px 9px;
    display: grid;
    grid-template-columns: 18px 1fr auto;
    gap: 6px;
    align-items: start;
  }
  .dm-notif-icon {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: linear-gradient(135deg, #8B5CF6, #6D28D9);
  }
  .dm-notif-app {
    font-size: 7.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    font-weight: 700;
  }
  .dm-notif-title {
    font-size: 9px;
    font-weight: 700;
    color: var(--text-primary);
  }
  .dm-notif-body {
    font-size: 8.5px;
    color: var(--text-secondary);
    line-height: 1.3;
  }
  .dm-notif-time {
    font-size: 7.5px;
    color: var(--text-muted);
  }

  /* Sheet handle */
  .dm-sheet-handle {
    width: 30px;
    height: 3px;
    background: rgba(255,255,255,0.2);
    border-radius: 2px;
    margin: 0 auto 4px;
  }

  /* Stepper */
  .dm-stepper {
    display: inline-flex;
    align-items: center;
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
  }
  .dm-stepper-btn {
    width: 17px;
    height: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-light);
    font-size: 11px;
    font-weight: 700;
  }
  .dm-stepper-val {
    padding: 0 6px;
    font-size: 9.5px;
    font-weight: 700;
    color: var(--text-primary);
    border-left: 1px solid rgba(255,255,255,0.08);
    border-right: 1px solid rgba(255,255,255,0.08);
    height: 17px;
    display: flex;
    align-items: center;
  }

  /* Time display */
  .dm-time-box {
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-primary);
    border: 1px solid rgba(255,255,255,0.08);
  }

  /* Slider */
  .dm-slider {
    height: 18px;
    display: flex;
    align-items: center;
    position: relative;
  }
  .dm-slider-track {
    flex: 1;
    height: 3px;
    background: rgba(255,255,255,0.08);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }
  .dm-slider-track::before {
    content: '';
    position: absolute;
    inset: 0;
    width: var(--p, 50%);
    background: linear-gradient(90deg, #8B5CF6, #A78BFA);
    border-radius: 2px;
  }
  .dm-slider-thumb {
    position: absolute;
    left: var(--p, 50%);
