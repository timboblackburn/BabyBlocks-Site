---
interface Props {
  accent?: boolean;
  glow?: boolean;
  class?: string;
  padding?: 'sm' | 'md' | 'lg';
}

const {
  accent = false,
  glow = false,
  class: className = '',
  padding = 'md',
} = Astro.props;
---

<div class:list={[
  'glass-card',
  accent ? 'glass-card--accent' : '',
  glow ? 'glass-card--glow' : '',
  `glass-card--pad-${padding}`,
  className,
]}>
  <slot />
</div>

<style>
  /* Calm card: white surface, hairline border, soft layered shadow, gentle
     radius. The `glow` prop now means an interactive panel that lifts
     gently on hover. */
  .glass-card {
    background: var(--surface);
    border: var(--border-w) solid var(--hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .glass-card--accent {
    background: var(--tint-soft);
  }

  .glass-card--glow:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-lg);
  }

  .glass-card--pad-sm { padding: var(--space-4); }
  .glass-card--pad-md { padding: var(--space-6); }
  .glass-card--pad-lg { padding: var(--space-8); }
</style>
