---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import { BUDGETBABY_APP_STORE_URL } from '../data/appStore';
import PhoneMockup from '../components/abstract/PhoneMockup.astro';
import BudgetBabyPreview from '../components/abstract/BudgetBabyPreview.astro';
---

<Layout
  title="BabyBlocks: BudgetBaby and other iOS apps for family life"
  description="BudgetBaby helps you plan bills, spending, and savings without connecting your bank. Built by BabyBlocks, an independent studio."
  canonical="/"
  theme="core"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <a
            href="https://intriguinginsight.com"
            target="_blank"
            rel="noopener noreferrer"
            class="lineage-chip"
            data-event="lineage_chip_click"
            data-event-source="hero"
          >
            <span class="lineage-chip-faint">A solution from</span>
            <span class="lineage-chip-strong">Intriguing Insight</span>
            <span class="lineage-chip-sep" aria-hidden="true">·</span>
            <span class="lineage-chip-faint">Intrigue MMC LLC</span>
          </a>
          <div class="brand-row">
            <img src="/icons/budgetbaby-icon.png" alt="" width="40" height="40" class="brand-glyph" />
            <span class="brand-pill">BudgetBaby</span>
          </div>
          <h1 class="display-serif hero-title">
            Know what's safe<br />to spend today.
          </h1>
          <p class="hero-sub">
            Tell BudgetBaby what you earn, what you owe, and what you're trying
            to save. It does the math and gives you one number for today, with
            rent, bills, and savings already put aside.
          </p>

          <div class="hero-actions">
            <a href={BUDGETBABY_APP_STORE_URL} class="btn btn-primary btn-lg" target="_blank" rel="noopener" data-event="app_store_click">
              Download on the App Store
            </a>
            <a href="/budgetbaby" class="btn btn-secondary btn-lg" data-event="how_it_works_click">
              How it works
            </a>
          </div>
          <p class="hero-launch-note">
            Free on the App Store. Premium is optional.
          </p>

          <!-- Honest status row. No fabricated stars or avatars until there
               are real users to back them up. The single line tells visitors
               what they're looking at: an iOS app, live on the App Store, with
               a free tier and a paid one. -->
          <ul class="hero-facts" role="list">
            <li>No bank linking, ever</li>
            <li>iPhone, iOS 17 and up</li>
            <li>Free, with optional Premium</li>
          </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="phone-stage">
            {/* Back phone. Real Insights screenshot. */}
            <div class="phone-slot phone-slot--back">
              <PhoneMockup tone="dark" tilt={-3} width={210}>
                <img src="/screenshots/screen-insights.png" alt="BudgetBaby Insights screen" style="width:100%;height:100%;object-fit:cover;display:block;" />
              </PhoneMockup>
            </div>

            {/* Front phone. Real Home dashboard screenshot. */}
            <div class="phone-slot phone-slot--front">
              <PhoneMockup tone="dark" tilt={2} width={230}>
                <img src="/screenshots/screen-home.png" alt="BudgetBaby home dashboard" style="width:100%;height:100%;object-fit:cover;display:block;" />
              </PhoneMockup>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Feature band (warm) ────────────────────────────────────────────── -->
  <section class="feature-band">
    <div class="container">
      <div class="feature-band-grid">
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="target" size={22} /></div>
          <h3>One number, every day</h3>
          <p>See what's left to spend today, with rent, bills, and savings already taken out. No mental math.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="bar-chart-2" size={22} /></div>
          <h3>See the month coming</h3>
          <p>Bills land on a calendar, so you set the budget before payday instead of cleaning up after it.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="lock" size={22} /></div>
          <h3>Nothing touches your bank</h3>
          <p>You type what you spend. Your numbers stay on your phone unless you turn on backup yourself.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="file-text" size={22} /></div>
          <h3>Quick when you're busy</h3>
          <p>Logging an expense is a couple of taps. Open it, tap, done, and back to your day.</p>
        </div>
      </div>

      <div class="band-trust">
        <span class="band-trust-eyebrow">What it won't do</span>
        <p class="band-trust-line">
          No bank connection. No ads. Nothing about you sold. No upgrade nagging.
          <a href="/about">Here's why <span aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── Real app screenshots gallery ───────────────────────────────── -->
  <section class="shots-section">
    <div class="container">
      <div class="shots-head">
        <span class="eyebrow">See it in action</span>
        <h2 class="display-serif">The actual app. No mockups.</h2>
        <p>Every screen below is a real BudgetBaby capture &mdash; the dashboard, the buckets, the insights, the bills, the backup. This is what you get on day one.</p>
      </div>
    </div>
    <ul class="shots-rail" role="list">
      <li class="shot"><img src="/screenshots/bb-01-home.png" alt="BudgetBaby home dashboard: money remaining and safe to spend today" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Money on hand</span></li>
      <li class="shot"><img src="/screenshots/bb-02-priorities.png" alt="Color-coded spending buckets: Essentials, Variable, Fun, Unplanned" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Color-coded priorities</span></li>
      <li class="shot"><img src="/screenshots/bb-03-goals.png" alt="Savings goals with progress toward each goal" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Savings goals</span></li>
      <li class="shot"><img src="/screenshots/bb-04-insights.png" alt="Insights: month-over-month spending trends by category" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Where it went</span></li>
      <li class="shot"><img src="/screenshots/bb-05-bills.png" alt="Recurring bills and categories with due dates" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Every bill, on its day</span></li>
      <li class="shot"><img src="/screenshots/bb-06-logging.png" alt="Fast expense logging: amount, category, payment method" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Speedy logging</span></li>
      <li class="shot"><img src="/screenshots/bb-07-backup.png" alt="Encrypted backup and restore options" width="1050" height="1976" loading="lazy" decoding="async" /><span class="shot-cap">Encrypted &amp; yours</span></li>
    </ul>
  </section>

  <!-- ── More from BabyBlocks ────────────────────────────────────────── -->
  <section class="apps-section section-sm">
    <div class="container">
      <div class="apps-section-head">
        <div>
          <span class="eyebrow">More from BabyBlocks</span>
          <h2 class="display-serif">One app you can get today. Two more on the way.</h2>
          <p>Each app takes one annoying part of the day and makes it simple. Use the one you need and ignore the rest. They don't depend on each other.</p>
        </div>
      </div>

      <div class="apps-grid">
        <a href="/budgetbaby" class="app-card app-card--featured">
          <div class="app-card-head">
            <AppIcon app="budgetbaby" size={48} />
          </div>
          <h3>BudgetBaby</h3>
          <p>One number on your home screen tells you what you can spend today.</p>
          <span class="app-card-link">Learn more <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/pantrybaby" class="app-card">
          <div class="app-card-head">
            <AppIcon app="pantrybaby" size={48} />
            <span class="app-card-soon">Coming soon</span>
          </div>
          <h3>PantryBaby</h3>
          <p>What's in the cupboard, what you're out of, and what to grab on the way home.</p>
          <span class="app-card-link">Get notified <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/babyblocks-core" class="app-card">
          <div class="app-card-head">
            <div class="app-icon-future" aria-hidden="true">
              <Icon name="box" size={22} />
            </div>
            <span class="app-card-soon">Coming soon</span>
          </div>
          <h3>BabyBlocks Core</h3>
          <p>A single home for all the apps. Still an idea on paper, not in development yet.</p>
          <span class="app-card-link">Read the idea <span aria-hidden="true">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Pricing ─────────────────────────────────────────────────────── -->
  <section class="pricing-section section-sm">
    <div class="container">
      <div class="pricing-head section-header centered">
        <span class="eyebrow">Pricing</span>
        <h2 class="display-serif">Simple pricing for BudgetBaby.</h2>
        <p>The free version is a real app you can live in, not a trial. Premium adds more when you want it. Billed through the App Store on your iPhone, cancel anytime.</p>
      </div>

      <div class="pricing-cards">
        <div class="price-card">
          <div class="price-card-head">
            <span class="price-tier">Monthly</span>
            <div class="price-amt-row">
              <span class="price-amt">$7.99</span>
              <span class="price-period">/month</span>
            </div>
            <span class="price-save">Cancel anytime</span>
          </div>
          <ul class="price-features">
            <li>Everything in the free tier</li>
            <li>Unlimited custom categories / lists</li>
            <li>Cloud backup and restore</li>
            <li>Calendar sync &amp; reminders</li>
            <li>Premium-only insights</li>
          </ul>
          <a href={BUDGETBABY_APP_STORE_URL} class="btn btn-secondary price-cta" target="_blank" rel="noopener" data-event="app_store_click">Get BudgetBaby</a>
        </div>

        <div class="price-card price-card--featured">
          <div class="price-card-badge">Best value</div>
          <div class="price-card-head">
            <span class="price-tier">Annual</span>
            <div class="price-amt-row">
              <span class="price-amt">$69.99</span>
              <span class="price-period">/year</span>
            </div>
            <span class="price-save">Save 27% vs monthly</span>
          </div>
          <ul class="price-features">
            <li>Everything in Monthly</li>
            <li>Two months free</li>
            <li>Priority support</li>
            <li>Early access to new features</li>
            <li>Free trial on first sign-up</li>
          </ul>
          <a href={BUDGETBABY_APP_STORE_URL} class="btn btn-primary price-cta" target="_blank" rel="noopener" data-event="app_store_click">Start free trial</a>
        </div>
      </div>

      <p class="pricing-fineprint">
        The free version of each app has the core features and is genuinely usable. Premium drops the limits and adds the extras, per app. Cancel whenever you like from iOS Settings. Prices are in USD and can shift a little by store region.
      </p>
    </div>
  </section>

  <!-- ── Download anchor ──────────────────────────────────────────────── -->
  <section class="waitlist-section section-sm">
    <div class="container-sm">
      <div id="hero-waitlist" class="waitlist-anchor" style="text-align: center;">
        <h2 style="margin-bottom: var(--space-3);">You can get BudgetBaby right now.</h2>
        <p style="color: var(--text-secondary); margin-bottom: var(--space-6);">Free to start, Premium if you want more. iPhone, iOS 17 and up.</p>
        <a href={BUDGETBABY_APP_STORE_URL} class="btn btn-primary btn-lg" target="_blank" rel="noopener" data-event="app_store_click">
          Download on the App Store
        </a>
      </div>
    </div>
  </section>

  <CTASection
    heading="Stop guessing what you can spend."
    subheading="BudgetBaby is on the App Store now. Free to start, with Premium if you want it."
    primaryLabel="Download on the App Store"
    primaryHref={BUDGETBABY_APP_STORE_URL}
    secondaryLabel="How BudgetBaby works"
    secondaryHref="/budgetbaby"
  />
</Layout>

<style>
  /* ── Real app screenshots gallery ─────────────────────────────────── */
  .shots-section { padding: var(--space-24) 0 var(--space-16); }
  .shots-head { text-align: center; max-width: 44rem; margin: 0 auto var(--space-12); }
  .shots-head .eyebrow { color: var(--accent-deep); }
  .shots-head h2 { font-size: clamp(2rem, 4.2vw, 3rem); line-height: 1.08; margin-top: var(--space-3); }
  .shots-head p { color: var(--text-secondary); margin-top: var(--space-4); line-height: 1.6; }
  .shots-rail {
    display: flex;
    gap: var(--space-6);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    list-style: none;
    margin: 0;
    padding: var(--space-2) max(var(--space-6), calc((100vw - var(--max-w-xl)) / 2)) var(--space-6);
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--accent-border) transparent;
  }
  .shots-rail::-webkit-scrollbar { height: 6px; }
  .shots-rail::-webkit-scrollbar-thumb { background: var(--accent-border); border-radius: 999px; }
  .shot {
    flex: 0 0 auto;
    width: 232px;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .shot img {
    width: 100%;
    height: auto;
    border-radius: 26px;
    border: 1px solid var(--hairline-strong);
    box-shadow:
      0 24px 60px -22px rgba(120, 70, 220, 0.55),
      0 0 44px -22px rgba(155, 123, 255, 0.45);
  }
  .shot-cap {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.01em;
  }
  @media (max-width: 640px) { .shot { width: 200px; } }

  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--space-16) + var(--space-2));
    padding-bottom: var(--space-20);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-copy { max-width: 560px; }

  /* Lineage line. Sits above the BudgetBaby brand row so visitors who want
     to resolve "who made this" can see the chain (studio + holding company)
     without having to go to /about. A quiet inline line, no pill. */
  .lineage-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    margin-bottom: var(--space-4);
    transition: color 0.16s ease;
  }
  .lineage-chip:hover .lineage-chip-strong { color: var(--coral-700); }
  .lineage-chip-faint { color: var(--text-muted); }
  .lineage-chip-strong { color: var(--accent-deep); font-weight: 600; }
  .lineage-chip-sep { color: var(--text-faint); }

  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .brand-glyph {
    border-radius: 22%;
    border: 1px solid var(--hairline);
    box-shadow: var(--shadow-card-sm);
  }

  .brand-pill {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .hero-title {
    font-size: clamp(2.6rem, 5.8vw, 4.4rem);
    line-height: 1.06;
    font-weight: var(--weight-bold);
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: var(--space-5);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  /* Honest status line under the download CTA. Sets expectations: free on
     the App Store, with optional Premium. */
  .hero-launch-note {
    font-size: 0.85rem;
    color: var(--text-secondary, #6b7280);
    margin: 0 0 var(--space-6);
    max-width: 44ch;
  }

  /* ── Hero trust signals ── */
  /* Honest hero facts row. Three short pills, no fabricated stars or
     avatars. There are no public user counts to cite yet, so faked
     social proof is the wrong move. */
  .hero-facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .hero-facts li {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    font-weight: var(--weight-medium);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }
  .hero-facts li + li::before {
    content: '';
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: var(--text-faint);
    margin-right: var(--space-2);
  }

  /* ── Phone stage ─────────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phone-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 5 / 4;
    isolation: isolate;
  }

  .phone-slot {
    position: absolute;
  }
  .phone-slot--back  { left: 6%;  top: 8%;  z-index: 1; }
  .phone-slot--front { right: 4%; top: 0;   z-index: 2; }

  /* ── Feature band (calm) ────────────────────────────────────────── */
  /* A quiet soft-tint band so the section reads as distinct without any
     slab. The four tiles are calm white cards with a hairline, a soft
     shadow, and a small accent-tinted icon. No colored blocks. */
  .feature-band {
    background: var(--sand-200);
    border-top: var(--border-w) solid var(--hairline);
    border-bottom: var(--border-w) solid var(--hairline);
    padding-block: var(--space-20);
  }

  .feature-band-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
  }

  .feature-tile {
    background: var(--surface);
    border: var(--border-w) solid var(--hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .feature-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-lg);
  }

  /* Icon mark: a small accent-tinted rounded square with the accent glyph. */
  .feature-tile-icon {
    width: 40px; height: 40px;
    border-radius: 11px;
    background: var(--accent-dim);
    color: var(--accent-deep);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-5);
  }
  .feature-tile h3 {
    color: var(--text-primary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
  }
  .feature-tile p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .band-trust {
    margin-top: var(--space-12);
    padding-top: var(--space-10);
    border-top: var(--border-w) solid var(--hairline);
    text-align: center;
  }
  .band-trust-eyebrow {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--space-3);
  }
  .band-trust-line {
    font-size: var(--text-lg);
    color: var(--text-primary);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
    margin: 0 auto;
    font-weight: var(--weight-medium);
  }
  .band-trust-line a {
    color: var(--accent-deep);
    margin-left: var(--space-1);
    font-weight: var(--weight-bold);
    white-space: nowrap;
  }
  .band-trust-line a:hover { color: var(--coral-600); }

  /* ── Apps section ─────────────────────────────────────────── */
  .apps-section { padding-block: var(--space-20) var(--space-8); }

  .apps-section-head {
    margin-bottom: var(--space-10);
    max-width: 56ch;
  }
  .apps-section-head .eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--space-3);
  }
  .apps-section-head h2 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }
  .apps-section-head p {
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .app-card {
    background: var(--surface);
    border: var(--border-w) solid var(--hairline);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
    box-shadow: var(--shadow-card);
  }
  .app-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-lg);
  }
  .app-card--featured {
    background: var(--tint-soft);
    border-color: var(--accent-border);
  }

  .app-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
    min-height: 48px;
  }

  /* Quiet inline availability label for not-yet-shipped apps. */
  .app-card-soon {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-weight: var(--weight-medium);
  }

  .app-icon-future {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--sand-200);
    border: var(--border-w) solid var(--hairline);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .app-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }
  .app-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
