---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
---

<Layout
  title="BabyBlocks: BudgetBaby and other iOS apps for family life"
  description="BudgetBaby helps you plan bills, spending, and savings without connecting your bank. Built by BabyBlocks, an independent studio."
  canonical="/"
  theme="core"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <div class="brand-row">
            <img src="/icons/budgetbaby-icon.png" alt="" width="40" height="40" class="brand-glyph" />
            <span class="brand-pill">BudgetBaby</span>
            <span class="brand-status" aria-label="Status: in App Review">
              <span class="brand-status-dot" aria-hidden="true"></span>In App Review
            </span>
          </div>
          <h1 class="display-serif hero-title">
            Know what is safe<br />to spend today.
          </h1>
          <p class="hero-sub">
            BudgetBaby helps you plan bills, spending, and savings without connecting your bank.
            One number every day, after your bills and savings are set aside.
          </p>

          <div class="hero-actions">
            <a href="#hero-waitlist" class="btn btn-dark btn-lg">
              Join the waitlist
            </a>
            <a href="/budgetbaby" class="btn btn-secondary btn-lg">
              See how it works
            </a>
          </div>
          <p class="hero-note">iOS 17+. Free tier available. Premium $7.99/mo or $69.99/yr.</p>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="phone-stage">
            <!-- Back phone, dark Safe to Spend screen -->
            <div class="phone phone--back">
              <div class="phone-notch"></div>
              <div class="phone-screen phone-screen--dark">
                <div class="ps-greeting">
                  <span class="ps-time">9:21</span>
                  <span class="ps-signal" aria-hidden="true">
                    <span class="ps-bars"><i></i><i></i><i></i><i></i></span>
                  </span>
                </div>
                <div class="ps-headline">Good morning, Alex</div>
                <div class="ps-eyebrow">Here&rsquo;s what&rsquo;s safe to spend</div>
                <div class="ps-amount">$126<span>.50</span></div>
                <div class="ps-amount-meta">left for today</div>
                <div class="ps-bar"><div class="ps-bar-fill" style="width:62%"></div></div>
                <div class="ps-line"><span>$1,873.50 available this month</span></div>
                <div class="ps-line ps-muted">$3,000 monthly income</div>
                <div class="ps-section">Upcoming</div>
                <div class="ps-row">
                  <div class="ps-row-icon"><Icon name="home" size={10} /></div>
                  <div class="ps-row-info"><span>Rent</span><span class="ps-row-sub">May 1</span></div>
                  <span class="ps-row-amt">$1,200.00</span>
                </div>
                <div class="ps-row">
                  <div class="ps-row-icon"><Icon name="zap" size={10} /></div>
                  <div class="ps-row-info"><span>Electricity</span><span class="ps-row-sub">May 3</span></div>
                  <span class="ps-row-amt">$120.00</span>
                </div>
                <div class="ps-row">
                  <div class="ps-row-icon"><Icon name="users" size={10} /></div>
                  <div class="ps-row-info"><span>Daycare</span><span class="ps-row-sub">May 5</span></div>
                  <span class="ps-row-amt">$850.00</span>
                </div>
                <div class="ps-tab"><span>See All Bills</span></div>
                <div class="ps-tabbar">
                  <span class="ps-tab-item active">Home</span>
                  <span class="ps-tab-item">Budget</span>
                  <span class="ps-tab-item ps-tab-fab" aria-hidden="true">+</span>
                  <span class="ps-tab-item">Activity</span>
                  <span class="ps-tab-item">Settings</span>
                </div>
              </div>
            </div>

            <!-- Front phone, light Overview screen -->
            <div class="phone phone--front">
              <div class="phone-notch"></div>
              <div class="phone-screen phone-screen--light">
                <div class="ps-light-top">
                  <span class="ps-light-back">←</span>
                  <span class="ps-light-title">May 2024 ▾</span>
                  <span aria-hidden="true">⓿</span>
                </div>
                <div class="ps-light-eyebrow">Overview</div>
                <div class="ps-light-row"><span>Income</span><span class="ps-light-amt">$3,000.00</span></div>
                <div class="ps-light-row"><span>Bills</span><span class="ps-light-amt">$2,150.00</span></div>
                <div class="ps-light-row"><span>Spending</span><span class="ps-light-amt">$730.50</span></div>
                <div class="ps-light-row"><span>Savings</span><span class="ps-light-amt">$250.00</span></div>
                <div class="ps-light-eyebrow ps-light-eyebrow--mt">Spending by Category</div>
                <div class="ps-donut">
                  <svg viewBox="0 0 80 80" aria-hidden="true">
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#F2EAE0" stroke-width="14"/>
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#F25E72" stroke-width="14" stroke-dasharray="42 200" transform="rotate(-90 40 40)"/>
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#FFB8C7" stroke-width="14" stroke-dasharray="32 200" stroke-dashoffset="-42" transform="rotate(-90 40 40)"/>
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#FFD9BF" stroke-width="14" stroke-dasharray="22 200" stroke-dashoffset="-74" transform="rotate(-90 40 40)"/>
                  </svg>
                  <div class="ps-donut-inner">
                    <span class="ps-donut-amt">$730.50</span>
                    <span class="ps-donut-meta">total spent</span>
                  </div>
                </div>
                <ul class="ps-legend">
                  <li><span class="ps-dot" style="background:#F25E72"></span>Groceries<span class="ps-legend-amt">$285.40</span></li>
                  <li><span class="ps-dot" style="background:#FFB8C7"></span>Kids<span class="ps-legend-amt">$153.20</span></li>
                  <li><span class="ps-dot" style="background:#FFD9BF"></span>Transport<span class="ps-legend-amt">$98.50</span></li>
                  <li><span class="ps-dot" style="background:#A78BFA"></span>Dining<span class="ps-legend-amt">$72.60</span></li>
                </ul>
              </div>
            </div>

            <div class="phone-glow" aria-hidden="true"></div>
            <div class="phone-block phone-block--peach" aria-hidden="true"></div>
            <div class="phone-block phone-block--blush" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Dark feature strip ─────────────────────────────────────────────── -->
  <section class="dark-band feature-strip">
    <div class="container">
      <div class="feature-strip-grid">
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="target" size={22} /></div>
          <h3>Safe to Spend</h3>
          <p>One daily number. Bills and savings are already taken out.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="file-text" size={22} /></div>
          <h3>Bills and subscriptions</h3>
          <p>See what is due this month and the next. Reminders before each due date.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="bar-chart-2" size={22} /></div>
          <h3>Track in one tap</h3>
          <p>Log a transaction, pick a category and pool, and keep moving.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="lock" size={22} /></div>
          <h3>No bank connections</h3>
          <p>You enter what you spend. Nothing leaves your phone unless you turn on backup.</p>
        </div>
      </div>

      <!-- A single editorial trust line on the same dark band. Replaces the
           4-up icon grid that read as a generic SaaS feature row. -->
      <div class="dark-trust">
        <div class="dark-trust-rule" aria-hidden="true"></div>
        <p class="dark-trust-line">
          <span class="dark-trust-eyebrow">House rules</span>
          No bank connections. No selling data. No ads.
          <a href="/about">Read why <span aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── Apps family ─────────────────────────────────────────────────── -->
  <section class="apps-section section-sm">
    <div class="container">
      <div class="apps-section-head">
        <div>
          <span class="eyebrow">The other apps</span>
          <h2 class="display-serif">A few more iOS apps in the works.</h2>
          <p>Each app does one job. They share a look, but each one stands on its own.</p>
        </div>
      </div>

      <div class="apps-grid">
        <a href="/budgetbaby" class="app-card app-card--featured">
          <div class="app-card-head">
            <AppIcon app="budgetbaby" size={48} />
            <span class="app-status app-status--soon">
              <span class="status-dot status-dot--soon" aria-hidden="true"></span>In App Review
            </span>
          </div>
          <h3>BudgetBaby</h3>
          <p>Plan bills, spending, and savings without connecting your bank.</p>
          <span class="app-card-link">Learn more <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/pantrybaby" class="app-card">
          <div class="app-card-head">
            <AppIcon app="pantrybaby" size={48} />
            <span class="app-status app-status--build">
              <span class="status-dot status-dot--build" aria-hidden="true"></span>In development
            </span>
          </div>
          <h3>PantryBaby</h3>
          <p>Track what you have and what is running low. No more guessing at the store.</p>
          <span class="app-card-link">Get notified <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/babyblocks-core" class="app-card">
          <div class="app-card-head">
            <div class="app-icon-future" aria-hidden="true">
              <Icon name="box" size={22} />
            </div>
            <span class="app-status app-status--future">
              <span class="status-dot status-dot--future" aria-hidden="true"></span>Coming soon
            </span>
          </div>
          <h3>BabyBlocks Core</h3>
          <p>A shared home for the apps. Idea stage, not yet in development.</p>
          <span class="app-card-link">Read the brief <span aria-hidden="true">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Pricing teaser (BudgetBaby) ─────────────────────────────────── -->
  <section class="pricing-band section-sm">
    <div class="container">
      <div class="pricing-band-grid">
        <div class="pricing-band-copy">
          <span class="eyebrow">Pricing</span>
          <h2 class="display-serif">Start free. Pay if you want more.</h2>
          <p>The free tier is a working budgeting app. Premium removes limits and adds calendar sync, full reports, and unlimited categories. Cancel any time in iOS Settings.</p>
          <a href="/budgetbaby" class="btn btn-dark">See full pricing</a>
        </div>

        <div class="pricing-cards">
          <div class="price-card">
            <div class="price-card-head">
              <span class="price-tier">Free</span>
              <span class="price-amt">$0<small>/always</small></span>
            </div>
            <ul class="price-features">
              <li>Safe to Spend</li>
              <li>Track income &amp; bills</li>
              <li>Basic insights</li>
              <li>Local-first storage</li>
            </ul>
            <a href="/budgetbaby" class="btn btn-secondary price-cta">Get started</a>
          </div>

          <div class="price-card price-card--featured">
            <div class="price-card-head">
              <span class="price-tier">Premium</span>
              <span class="price-amt">$7.99<small>/month</small></span>
            </div>
            <ul class="price-features">
              <li>Everything in Free, plus</li>
              <li>Custom categories</li>
              <li>Unlimited goals &amp; bills</li>
              <li>Calendar sync &amp; reports</li>
            </ul>
            <a href="/budgetbaby#bb-waitlist" class="btn btn-primary price-cta">Join the waitlist</a>
          </div>
        </div>
      </div>

      <p class="pricing-fineprint">
        Annual is $69.99/yr with a 7 day free trial. Manage and cancel in iOS Settings.
      </p>
    </div>
  </section>

  <!-- ── Waitlist anchor ─────────────────────────────────────────────── -->
  <section class="waitlist-section section-sm">
    <div class="container-sm">
      <div id="hero-waitlist" class="waitlist-anchor">
        <WaitlistForm
          app="budgetbaby"
          heading="Get one email when BudgetBaby is back."
          sub="That is the only email. No newsletter, no marketing list."
        />
      </div>
    </div>
  </section>

  <CTASection
    heading="Get notified when BudgetBaby is back."
    subheading="The new build is in App Review. We will email you the day it goes live."
    primaryLabel="Join the waitlist"
    primaryHref="#hero-waitlist"
    secondaryLabel="See what is in it"
    secondaryHref="/budgetbaby"
  />
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--space-16) + var(--space-2));
    padding-bottom: var(--space-20);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-copy { max-width: 560px; }

  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .brand-glyph {
    border-radius: 22%;
    box-shadow: var(--shadow-sm);
  }

  .brand-pill {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .brand-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: var(--space-2);
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .brand-status-dot {
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(242, 94, 114, 0.16);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    line-height: 1.04;
    color: var(--text-primary);
    margin-bottom: var(--space-5);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .hero-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* ── Phone stage ─────────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phone-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 5 / 4;
    isolation: isolate;
  }

  .phone-glow {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(circle at 65% 50%, rgba(255, 184, 199, 0.55) 0%, transparent 55%),
      radial-gradient(circle at 30% 70%, rgba(255, 217, 191, 0.50) 0%, transparent 55%);
    filter: blur(4px);
    z-index: -2;
  }

  .phone-block {
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }
  .phone-block--peach {
    width: 150px; height: 150px;
    right: -10%; bottom: 4%;
    background: var(--peach-200);
    opacity: 0.85;
  }
  .phone-block--blush {
    width: 70px; height: 70px;
    right: 16%; top: -4%;
    background: var(--blush-300);
    opacity: 0.85;
  }

  .phone {
    position: absolute;
    width: 200px;
    aspect-ratio: 200 / 410;
    background: #0F0E14;
    border-radius: 32px;
    padding: 6px;
    box-shadow:
      0 0 0 2px rgba(20, 16, 12, 0.06),
      0 30px 70px rgba(60, 30, 20, 0.20),
      0 8px 24px rgba(60, 30, 20, 0.10);
    overflow: hidden;
  }
  .phone--back  { left: 30%;  top: 6%;  transform: rotate(-3deg); z-index: 1; }
  .phone--front { right: 6%;  top: 0;   transform: rotate(2deg);  z-index: 2; }

  .phone-notch {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    width: 56px;
    height: 16px;
    background: #0F0E14;
    border-radius: 0 0 12px 12px;
    z-index: 3;
  }

  .phone-screen {
    border-radius: 26px;
    height: 100%;
    overflow: hidden;
    padding: 22px 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 9px;
  }

  .phone-screen--dark {
    background: #131217;
    color: rgba(255, 247, 239, 0.9);
  }
  .phone-screen--light {
    background: var(--cream-50);
    color: var(--ink-900);
  }

  .ps-greeting {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 8px;
    color: rgba(255, 247, 239, 0.65);
    margin-bottom: 4px;
  }
  .ps-signal { display: inline-flex; align-items: flex-end; }
  .ps-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 1px;
    height: 8px;
  }
  .ps-bars i {
    display: block;
    width: 2px;
    background: rgba(255, 247, 239, 0.55);
    border-radius: 1px;
  }
  .ps-bars i:nth-child(1) { height: 3px; }
  .ps-bars i:nth-child(2) { height: 5px; }
  .ps-bars i:nth-child(3) { height: 7px; }
  .ps-bars i:nth-child(4) { height: 8px; }
  .ps-headline {
    font-size: 11px;
    font-weight: 600;
    color: #FFF7EF;
  }
  .ps-eyebrow {
    font-size: 8px;
    color: rgba(255, 247, 239, 0.55);
  }
  .ps-amount {
    font-size: 26px;
    font-weight: 700;
    color: #FFF7EF;
    letter-spacing: -0.04em;
    line-height: 1;
    margin-top: 2px;
  }
  .ps-amount span { font-size: 14px; opacity: 0.7; }
  .ps-amount-meta {
    font-size: 8px;
    color: rgba(255, 247, 239, 0.55);
  }
  .ps-bar {
    height: 4px;
    background: rgba(255, 247, 239, 0.10);
    border-radius: 999px;
    overflow: hidden;
    margin: 4px 0 2px;
  }
  .ps-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--coral-500), var(--peach-300));
    border-radius: 999px;
  }
  .ps-line {
    font-size: 8px;
    color: rgba(255, 247, 239, 0.78);
  }
  .ps-line.ps-muted { color: rgba(255, 247, 239, 0.45); }
  .ps-section {
    font-size: 9px;
    font-weight: 600;
    color: #FFF7EF;
    margin: 4px 0 1px;
  }
  .ps-row {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 0;
    border-bottom: 1px solid rgba(255, 247, 239, 0.06);
  }
  .ps-row-icon {
    width: 16px; height: 16px;
    border-radius: 5px;
    background: rgba(255, 247, 239, 0.06);
    color: var(--peach-200);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ps-row-icon :global(svg) {
    width: 10px;
    height: 10px;
  }
  .ps-row-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    font-size: 8px;
  }
  .ps-row-info span { color: #FFF7EF; }
  .ps-row-sub { color: rgba(255, 247, 239, 0.45) !important; font-size: 7px; }
  .ps-row-amt { font-size: 8px; color: #FFF7EF; font-weight: 600; }
  .ps-tab {
    background: rgba(255, 247, 239, 0.04);
    border-radius: 8px;
    text-align: center;
    padding: 5px 0;
    font-size: 8px;
    color: rgba(255, 247, 239, 0.7);
    margin-top: 3px;
  }
  .ps-tabbar {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin-top: auto;
    padding-top: 4px;
    border-top: 1px solid rgba(255, 247, 239, 0.06);
    font-size: 7px;
    color: rgba(255, 247, 239, 0.45);
  }
  .ps-tab-item.active { color: #FFF7EF; }
  .ps-tab-fab {
    width: 22px; height: 22px;
    border-radius: 999px;
    background: var(--coral-500);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
  }

  /* Light phone */
  .ps-light-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 9px;
    color: var(--ink-800);
    margin-bottom: 4px;
  }
  .ps-light-back { font-weight: 600; }
  .ps-light-title { font-weight: 600; }
  .ps-light-eyebrow {
    font-size: 8px;
    font-weight: 600;
    color: var(--ink-700);
    margin: 4px 0 2px;
  }
  .ps-light-eyebrow--mt { margin-top: 8px; }
  .ps-light-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2px 0;
    border-bottom: 1px solid rgba(21, 17, 13, 0.06);
    font-size: 8px;
    color: var(--text-secondary);
  }
  .ps-light-amt { color: var(--ink-900); font-weight: 600; }

  .ps-donut {
    position: relative;
    width: 96px;
    margin: 4px auto 4px;
  }
  .ps-donut svg {
    width: 96px;
    height: 96px;
    display: block;
  }
  .ps-donut-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
  }
  .ps-donut-amt { font-size: 11px; font-weight: 700; color: var(--ink-900); letter-spacing: -0.02em; }
  .ps-donut-meta { font-size: 7px; color: var(--text-muted); }

  .ps-legend {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 8px;
    color: var(--text-secondary);
  }
  .ps-legend li {
    display: flex;
    align-items: center;
