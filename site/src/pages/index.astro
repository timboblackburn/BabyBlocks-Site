---
import Layout from '../layouts/Layout.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import PhoneMockup from '../components/abstract/PhoneMockup.astro';
import BudgetBabyPreview from '../components/abstract/BudgetBabyPreview.astro';
---

<Layout
  title="BabyBlocks: BudgetBaby and other iOS apps for family life"
  description="BudgetBaby helps you plan bills, spending, and savings without connecting your bank. Built by BabyBlocks, an independent studio."
  canonical="/"
  theme="core"
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-copy">
          <a
            href="https://intriguinginsight.com"
            target="_blank"
            rel="noopener noreferrer"
            class="lineage-chip"
            data-event="lineage_chip_click"
            data-event-source="hero"
          >
            <span class="lineage-chip-faint">A solution from</span>
            <span class="lineage-chip-strong">Intriguing Insight</span>
            <span class="lineage-chip-sep" aria-hidden="true">·</span>
            <span class="lineage-chip-faint">Intrigue MMC LLC</span>
          </a>
          <div class="brand-row">
            <img src="/icons/budgetbaby-icon.png" alt="" width="40" height="40" class="brand-glyph" />
            <span class="brand-pill">BudgetBaby</span>
            <span class="brand-status" aria-label="Status: in App Review">
              <span class="brand-status-dot" aria-hidden="true"></span>In App Review
            </span>
          </div>
          <h1 class="display-serif hero-title">
            Know what's safe<br />to spend today.
          </h1>
          <p class="hero-sub">
            BudgetBaby helps you budget with confidence. Tell it your income,
            your bills, and what you want to save, it gives you one number
            you can actually spend, right now.
          </p>

          <div class="hero-actions">
            <a href="#hero-waitlist" class="btn btn-dark btn-lg" data-event="hero_waitlist_click">
              Get notified when it launches
            </a>
            <a href="/budgetbaby" class="btn btn-secondary btn-lg" data-event="how_it_works_click">
              How it works
            </a>
          </div>
          <p class="hero-launch-note">
            BudgetBaby is in App Review. One email when it goes live. Nothing else.
          </p>

          <!-- Trust signals: avatars + star rating -->
          <div class="hero-trust">
            <div class="trust-avatars" aria-hidden="true">
              <span class="trust-avatar trust-avatar--1"></span>
              <span class="trust-avatar trust-avatar--2"></span>
              <span class="trust-avatar trust-avatar--3"></span>
              <span class="trust-avatar trust-avatar--4"></span>
              <span class="trust-avatar trust-avatar--5"></span>
            </div>
            <div class="trust-rating">
              <span class="trust-stars" aria-label="5 stars">
                <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.3 2.6L10 4l-2 2 .5 2.8L6 7.4l-2.5 1.4L4 6 2 4l2.7-.4z"/></svg>
                <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.3 2.6L10 4l-2 2 .5 2.8L6 7.4l-2.5 1.4L4 6 2 4l2.7-.4z"/></svg>
                <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.3 2.6L10 4l-2 2 .5 2.8L6 7.4l-2.5 1.4L4 6 2 4l2.7-.4z"/></svg>
                <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.3 2.6L10 4l-2 2 .5 2.8L6 7.4l-2.5 1.4L4 6 2 4l2.7-.4z"/></svg>
                <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M6 1l1.3 2.6L10 4l-2 2 .5 2.8L6 7.4l-2.5 1.4L4 6 2 4l2.7-.4z"/></svg>
              </span>
              <span class="trust-copy">Loved by early families &middot; iOS 17+</span>
            </div>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="phone-stage">
            <div class="phone-glow" aria-hidden="true"></div>
            <div class="phone-block phone-block--peach" aria-hidden="true"></div>
            <div class="phone-block phone-block--blush" aria-hidden="true"></div>

            {/* Back phone. Insights screen. */}
            <div class="phone-slot phone-slot--back">
              <PhoneMockup tone="dark" tilt={-3} width={210}>
                <BudgetBabyPreview variant="insights" />
              </PhoneMockup>
            </div>

            {/* Front phone. Home dashboard. */}
            <div class="phone-slot phone-slot--front">
              <PhoneMockup tone="dark" tilt={2} width={230}>
                <BudgetBabyPreview variant="home" />
              </PhoneMockup>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Dark feature strip ─────────────────────────────────────────────── -->
  <section class="dark-band feature-strip">
    <div class="container">
      <div class="feature-strip-grid">
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="target" size={22} /></div>
          <h3>Safe to Spend</h3>
          <p>One number that tells you exactly what you can spend today. Rent, bills, and savings are already accounted for.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="bar-chart-2" size={22} /></div>
          <h3>Plan Ahead</h3>
          <p>See your upcoming bills on a calendar. Budget for the month before the month starts, not after it ends.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="lock" size={22} /></div>
          <h3>Trust Everything</h3>
          <p>No bank connection. No data leaving your phone unless you flip on backup. Your finances stay private.</p>
        </div>
        <div class="feature-tile">
          <div class="feature-tile-icon"><Icon name="file-text" size={22} /></div>
          <h3>Built for Parents</h3>
          <p>Designed for busy households. Log an expense in a tap. Back to your day before the baby notices.</p>
        </div>
      </div>

      <div class="dark-trust">
        <div class="dark-trust-rule" aria-hidden="true"></div>
        <p class="dark-trust-line">
          <span class="dark-trust-eyebrow">A few things we will not do</span>
          Plug into your bank. Sell your data. Show you ads. Keep nudging you to upgrade.
          <a href="/about">Why <span aria-hidden="true">&rarr;</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- ── More from BabyBlocks ────────────────────────────────────────── -->
  <section class="apps-section section-sm">
    <div class="container">
      <div class="apps-section-head">
        <div>
          <span class="eyebrow">More from BabyBlocks</span>
          <h2 class="display-serif">A few more apps in the works.</h2>
          <p>Each app solves one specific daily headache. Grab one, skip the rest, they work independently.</p>
        </div>
      </div>

      <div class="apps-grid">
        <a href="/budgetbaby" class="app-card app-card--featured">
          <div class="app-card-head">
            <AppIcon app="budgetbaby" size={48} />
            <span class="app-status app-status--soon">
              <span class="status-dot status-dot--soon" aria-hidden="true"></span>In App Review
            </span>
          </div>
          <h3>BudgetBaby</h3>
          <p>One number on your home screen tells you what you can spend today.</p>
          <span class="app-card-link">Learn more <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/pantrybaby" class="app-card">
          <div class="app-card-head">
            <AppIcon app="pantrybaby" size={48} />
            <span class="app-status app-status--build">
              <span class="status-dot status-dot--build" aria-hidden="true"></span>In development
            </span>
          </div>
          <h3>PantryBaby</h3>
          <p>What is in the cupboard, what you are out of, and what to grab on the way home.</p>
          <span class="app-card-link">Get notified <span aria-hidden="true">&rarr;</span></span>
        </a>

        <a href="/coming-soon/babyblocks-core" class="app-card">
          <div class="app-card-head">
            <div class="app-icon-future" aria-hidden="true">
              <Icon name="box" size={22} />
            </div>
            <span class="app-status app-status--future">
              <span class="status-dot status-dot--future" aria-hidden="true"></span>Coming soon
            </span>
          </div>
          <h3>BabyBlocks Core</h3>
          <p>A single home for all the apps. Still on paper. Nothing is being coded yet.</p>
          <span class="app-card-link">Read the idea <span aria-hidden="true">&rarr;</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ── Pricing ─────────────────────────────────────────────────────── -->
  <section class="pricing-section section-sm">
    <div class="container">
      <div class="pricing-head section-header centered">
        <span class="eyebrow">Pricing</span>
        <h2 class="display-serif">Simple, transparent pricing.</h2>
        <p>Free is a real budgeting app, not a demo. Pay only when you want the extras.</p>
      </div>

      <div class="pricing-cards">
        <div class="price-card">
          <div class="price-card-head">
            <span class="price-tier">Monthly</span>
            <div class="price-amt-row">
              <span class="price-amt">$2.99</span>
              <span class="price-period">/month</span>
            </div>
          </div>
          <ul class="price-features">
            <li>Safe to Spend number, daily</li>
            <li>Unlimited bills &amp; income</li>
            <li>Money Pools (Cash, Card, Savings)</li>
            <li>Spending by category</li>
            <li>Local-first, private storage</li>
          </ul>
          <a href="#hero-waitlist" class="btn btn-secondary price-cta">Get started</a>
        </div>

        <div class="price-card price-card--featured">
          <div class="price-card-badge">Best value</div>
          <div class="price-card-head">
            <span class="price-tier">Annual</span>
            <div class="price-amt-row">
              <span class="price-amt">$24.99</span>
              <span class="price-period">/year</span>
            </div>
            <span class="price-save">Save 30% vs monthly</span>
          </div>
          <ul class="price-features">
            <li>Everything in Monthly, plus</li>
            <li>Calendar sync &amp; bill reminders</li>
            <li>Monthly spending reports</li>
            <li>Unlimited custom categories</li>
            <li>7-day free trial</li>
          </ul>
          <a href="#hero-waitlist" class="btn btn-primary price-cta">Start free trial</a>
        </div>
      </div>

      <p class="pricing-fineprint">
        A free tier is available with core budgeting features. Premium unlocks the extras. Cancel anytime from iOS Settings.
      </p>
    </div>
  </section>

  <!-- ── Waitlist anchor ─────────────────────────────────────────────── -->
  <section class="waitlist-section section-sm">
    <div class="container-sm">
      <div id="hero-waitlist" class="waitlist-anchor">
        <WaitlistForm
          app="budgetbaby"
          heading="Drop your email. We'll tell you the day it's back."
          sub="One email, just from us. No newsletter, no marketing, no list trades."
        />
      </div>
    </div>
  </section>

  <CTASection
    heading="Ready to budget with confidence?"
    subheading="BudgetBaby is in App Review. Drop your email and we'll send you one notification the moment it's live on the App Store."
    primaryLabel="Join the waitlist"
    primaryHref="#hero-waitlist"
    secondaryLabel="How BudgetBaby works"
    secondaryHref="/budgetbaby"
  />
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--space-16) + var(--space-2));
    padding-bottom: var(--space-20);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-copy { max-width: 560px; }

  /* Lineage chip. Sits above the BudgetBaby brand row so visitors who want
     to resolve "who made this" can see the chain (studio + holding company)
     without having to go to /about. */
  .lineage-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(122, 32, 48, 0.22);
    background: rgba(122, 32, 48, 0.05);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    margin-bottom: var(--space-4);
    transition: border-color 140ms ease, background 140ms ease;
  }
  .lineage-chip:hover {
    border-color: rgba(122, 32, 48, 0.4);
    background: rgba(122, 32, 48, 0.08);
  }
  .lineage-chip-faint { color: var(--text-secondary, #6b7280); }
  .lineage-chip-strong { color: #7A2030; font-weight: 600; }
  .lineage-chip-sep { color: var(--text-tertiary, #9ca3af); }

  .brand-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .brand-glyph {
    border-radius: 22%;
    box-shadow: var(--shadow-sm);
  }

  .brand-pill {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  .brand-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: var(--space-2);
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: var(--weight-medium);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .brand-status-dot {
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(242, 94, 114, 0.16);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    line-height: 1.04;
    color: var(--text-primary);
    margin-bottom: var(--space-5);
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 48ch;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    margin-bottom: var(--space-3);
  }

  /* Honest status line under the waitlist CTA. Sets expectations so
     visitors aren't surprised the App Store link isn't live yet. */
  .hero-launch-note {
    font-size: 0.85rem;
    color: var(--text-secondary, #6b7280);
    margin: 0 0 var(--space-6);
    max-width: 44ch;
  }

  /* ── Hero trust signals ── */
  .hero-trust {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .trust-avatars {
    display: flex;
    align-items: center;
  }

  .trust-avatar {
    display: inline-block;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 2px solid var(--cream-100);
    margin-left: -8px;
    background-size: cover;
    background-position: center;
    box-shadow: var(--shadow-sm);
  }
  .trust-avatar:first-child { margin-left: 0; }

  /* Placeholder avatar colors until real photos are available */
  .trust-avatar--1 { background-color: var(--peach-200); }
  .trust-avatar--2 { background-color: var(--blush-200); }
  .trust-avatar--3 { background-color: var(--peach-300); }
  .trust-avatar--4 { background-color: var(--blush-300); }
  .trust-avatar--5 { background-color: var(--peach-100); }

  .trust-rating {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .trust-stars {
    display: flex;
    align-items: center;
    gap: 2px;
    color: #F5A623;
  }
  .trust-stars svg {
    width: 14px; height: 14px;
  }

  .trust-copy {
    font-size: var(--text-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* ── Phone stage ─────────────────────────────────────────────────── */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .phone-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    aspect-ratio: 5 / 4;
    isolation: isolate;
  }

  .phone-glow {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(circle at 65% 50%, rgba(255, 184, 199, 0.55) 0%, transparent 55%),
      radial-gradient(circle at 30% 70%, rgba(255, 217, 191, 0.50) 0%, transparent 55%);
    filter: blur(4px);
    z-index: -2;
  }

  .phone-block {
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }
  .phone-block--peach {
    width: 150px; height: 150px;
    right: -10%; bottom: 4%;
    background: var(--peach-200);
    opacity: 0.85;
  }
  .phone-block--blush {
    width: 70px; height: 70px;
    right: 16%; top: -4%;
    background: var(--blush-300);
    opacity: 0.85;
  }

  .phone-slot {
    position: absolute;
  }
  .phone-slot--back  { left: 6%;  top: 8%;  z-index: 1; }
  .phone-slot--front { right: 4%; top: 0;   z-index: 2; }

  /* ── Dark feature strip ─────────────────────────────────────────── */
  .feature-strip { padding-block: var(--space-16); }

  .feature-strip-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }

  .feature-tile {
    border: 1px solid rgba(255, 247, 239, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    background: rgba(255, 247, 239, 0.025);
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .feature-tile:hover {
    border-color: rgba(255, 184, 199, 0.30);
    transform: translateY(-2px);
  }
  .feature-tile-icon {
    width: 40px; height: 40px;
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(255, 207, 216, 0.16), rgba(255, 207, 216, 0.06));
    border: 1px solid rgba(255, 207, 216, 0.18);
    color: var(--blush-300);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-4);
  }
  .feature-tile h3 {
    color: #FFF7EF;
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
    font-weight: var(--weight-semibold);
  }
  .feature-tile p {
    color: rgba(255, 247, 239, 0.65);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .dark-trust {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    text-align: center;
  }
  .dark-trust-rule {
    width: 36px;
    height: 1px;
    background: rgba(255, 247, 239, 0.20);
    margin: 0 auto var(--space-6);
  }
  .dark-trust-line {
    font-size: var(--text-base);
    color: rgba(255, 247, 239, 0.78);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
    margin: 0 auto;
  }
  .dark-trust-eyebrow {
    display: block;
    font-size: 10px;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--peach-200);
    margin-bottom: var(--space-3);
  }
  .dark-trust-line a {
    color: var(--peach-200);
    margin-left: var(--space-2);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }
  .dark-trust-line a:hover { color: #FFF7EF; }

  /* ── Apps section ─────────────────────────────────────────── */
  .apps-section { padding-block: var(--space-20) var(--space-8); }

  .apps-section-head {
    margin-bottom: var(--space-10);
    max-width: 56ch;
  }
  .apps-section-head .eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-bottom: var(--space-3);
  }
  .apps-section-head h2 {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-4xl));
    margin-bottom: var(--space-3);
    color: var(--text-primary);
  }
  .apps-section-head p {
    font-size: var(--text-base);
    color: var(--text-secondary);
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .app-card {
    background: #FFFFFF;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: var(--shadow-sm);
  }
  .app-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--glass-border-strong);
  }
  .app-card--featured {
    background: linear-gradient(180deg, var(--cream-50) 0%, #FFFFFF 100%);
    border-color: var(--accent-border);
  }

  .app-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .app-icon-future {
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--cream-200);
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .app-status {
    font-size: 11px;
    font-weight: var(--weight-semibold);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.10em;
  }
  .app-status--soon   { color: var(--accent-deep); }
  .app-status--build  { color: var(--text-secondary); }
  .app-status--future { color: var(--text-faint); }

  .status-dot {
    width: 7px; height: 7px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .status-dot--soon {
    background: var(--coral-500);
    box-shadow: 0 0 0 3px rgba(242, 94, 114, 0.16);
  }
  .status-dot--build {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--text-muted);
  }
  .status-dot--future {
    background: var(--text-faint);
    border-radius: 1px;
    width: 6px; height: 6px;
  }

  .app-card h3 {
    font-size: var(--text-xl);
    color: var(--text-primary);
