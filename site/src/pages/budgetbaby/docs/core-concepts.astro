          <div class="dm-hero-label">Safe to Spend</div>
          <div class="dm-hero-amount green">$97<span class="dm-cents">.62</span></div>
          <div class="dm-hero-sub">21 days · all bills paid</div>
        </div>
        <div class="dm-card">
          <div class="dm-row" style="background:transparent; border:none; padding:0;">
            <span class="dm-dot critical"></span>
