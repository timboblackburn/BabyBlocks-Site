          <div class="dm-hero-label">Today's daily rate</div>
          <div class="dm-hero-amount green" style="font-size:24px;">$54<span class="dm-cents">.76</span></div>
        </div>
        <div class="dm-card">
          <div class="dm-kv"><span>Remaining budget</span><strong>$2,650</strong></div>
          <div class="dm-kv"><span>Bill reserve (red)</span><span class="muted">−$900</span></div>
          <div class="dm-kv"><span>Savings reserve</span><span class="muted">−$600</span></div>
          <div class="dm-kv-divider"></div>
          <div class="dm-kv"><strong>Spendable</strong><strong class="green">$1,150</strong></div>
