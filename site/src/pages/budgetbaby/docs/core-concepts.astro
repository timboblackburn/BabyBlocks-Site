          <div class="dm-kv-divider"></div>
          <div class="dm-kv"><span>Effect on Debit</span><span class="muted">$0</span></div>
          <div class="dm-kv"><span>Effect on Credit owed</span><span class="red">+$120</span></div>
          <div class="dm-kv"><span>Effect on Safe to Spend</span><span class="red">−$120</span></div>
        </div>
      </DocMock>
      <DocMock label="Pay the card" caption="Log a Debit→Credit transfer when the card statement clears.">
        <div class="dm-bar"><span class="dm-back">Cancel</span><span class="dm-bar-title">Transfer</span><span class="dm-bar-action">Save</span></div>
