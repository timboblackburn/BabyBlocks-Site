          <div class="dm-row"><span class="dm-icon target">T</span><span class="dm-row-label">Allocation edit<div class="dm-row-meta" style="font-size:8px;">Yesterday</div></span><span class="dm-pill muted">Manual</span></div>
        </div>
      </DocMock>
