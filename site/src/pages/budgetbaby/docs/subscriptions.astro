            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Priority colors (Essentials, Variable, Fun, Unplanned)</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Default category set</td>
            <td class="val-yes">12 categories</td>
            <td class="val-yes">12 categories</td>
          </tr>
          <tr>
