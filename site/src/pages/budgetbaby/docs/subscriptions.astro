        </thead>
        <tbody>
          <tr class="group-row">
            <td colspan="3">Core Budgeting</td>
          </tr>
          <tr>
            <td>Transactions</td>
            <td class="val-yes">Unlimited</td>
            <td class="val-yes">Unlimited</td>
          </tr>
          <tr>
            <td>Budget periods</td>
            <td class="val-yes">Unlimited</td>
            <td class="val-yes">Unlimited</td>
          </tr>
          <tr>
            <td>Safe to Spend calculation</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Money Pools (Cash, Card, Savings)</td>
