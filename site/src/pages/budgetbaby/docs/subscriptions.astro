            <td class="val-yes">5 slots</td>
          </tr>
          <tr>
            <td>iOS Calendar sync</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Cloud sync</td>
            <td class="val-no">No</td>
            <td class="val-limit">Rolling out</td>
          </tr>
          <tr class="group-row">
            <td colspan="3">Reminders</td>
          </tr>
          <tr>
            <td>Same-day bill reminders</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Weekly bill summary digest</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Multi-day bill reminders (3 days, 1 week before)</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Per-subscription reminders</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Custom notification messages per bill or subscription</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Quiet hours (suppress notifications)</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Monthly savings nudge notification</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="doc-mocks-row">
      <DocMock label="Free home" caption="Same Safe to Spend, all four pools, full priority system on the free tier.">
        <div class="dm-bar"><span class="dm-bar-title">Home</span><span class="dm-bar-action">+</span></div>
        <div class="dm-card dm-card-accent" style="text-align:center;">
          <div class="dm-hero-label">Safe to Spend</div>
          <div class="dm-hero-amount green">$54<span class="dm-cents">.76</span></div>
        </div>
        <div class="dm-section-label">Pools</div>
        <div class="dm-list">
          <div class="dm-row"><span class="dm-icon cash">$</span><span class="dm-row-label">Cash</span><span class="dm-row-meta">$60</span></div>
          <div class="dm-row"><span class="dm-icon debit">B</span><span class="dm-row-label">Debit</span><span class="dm-row-meta">$1,847</span></div>
          <div class="dm-row"><span class="dm-icon credit">C</span><span class="dm-row-label">Credit</span><span class="dm-row-meta">−$120</span></div>
          <div class="dm-row"><span class="dm-icon savings">S</span><span class="dm-row-label">Savings</span><span class="dm-row-meta">$3,200</span></div>
        </div>
        <div class="dm-help">Free tier · 1 backup slot · 3 bills · 5 categories</div>
      </DocMock>
      <DocMock label="Premium upsell" caption="Unlock unlimited bills, multi-day reminders, PDF exports, sync, and more.">
        <div class="dm-bar"><span class="dm-back">Settings</span><span class="dm-bar-title">Premium</span><span></span></div>
        <div class="dm-card dm-card-accent" style="text-align:center;">
          <span class="dm-pill purple" style="margin:0 auto;">Best Value</span>
          <div class="dm-h2" style="margin-top:6px;">Annual</div>
          <div class="dm-hero-amount" style="font-size:24px;">$69<span class="dm-cents">.99</span></div>
          <div class="dm-hero-sub">≈ $5.83/mo · save 27%</div>
        </div>
        <div class="dm-card">
          <div class="dm-h2">Or monthly</div>
          <div class="dm-kv"><span>$7.99/mo</span><span class="muted">cancel any time</span></div>
        </div>
        <div class="dm-list">
          <div class="dm-row"><span style="color:#34D399;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg></span><span class="dm-row-label">Unlimited bills, subs, goals</span></div>
          <div class="dm-row"><span style="color:#34D399;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg></span><span class="dm-row-label">Advanced insights + PDF</span></div>
          <div class="dm-row"><span style="color:#34D399;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg></span><span class="dm-row-label">5 backup slots · cloud sync</span></div>
