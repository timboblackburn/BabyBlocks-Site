            <td class="val-yes">Unlimited</td>
          </tr>
          <tr>
            <td>Savings goals</td>
            <td class="val-limit">Up to 3</td>
            <td class="val-yes">Unlimited</td>
          </tr>
          <tr>
            <td>Important expenses</td>
            <td class="val-limit">Up to 3</td>
            <td class="val-yes">Unlimited</td>
          </tr>

          <tr class="group-row">
            <td colspan="3">Insights</td>
          </tr>
          <tr>
            <td>Spending breakdown by category</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Basic spending summary per period</td>
            <td class="val-yes">Yes</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Spending trends over time</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Month-over-month comparison</td>
            <td class="val-no">No</td>
            <td class="val-yes">Yes</td>
          </tr>
          <tr>
            <td>Category drill-down by period</td>
