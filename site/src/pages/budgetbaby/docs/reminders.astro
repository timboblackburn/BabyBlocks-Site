      </DocMock>
      <DocMock label="iOS permission" caption="Without iOS notification permission, no BudgetBaby reminders can fire.">
        <div class="dm-bar"><span class="dm-back">BudgetBaby</span><span class="dm-bar-title">Notifications</span><span></span></div>
        <div class="dm-row"><span class="dm-row-label">Allow Notifications</span><span class="dm-toggle on"></span></div>
        <div class="dm-section-label">Alerts</div>
        <div class="dm-list">
          <div class="dm-row"><span class="dm-row-label">Lock Screen</span><span style="color:#34D399; font-size:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg></span></div>
          <div class="dm-row"><span class="dm-row-label">Notification Centre</span><span style="color:#34D399; font-size:14px;"><svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;"><polyline points="20 6 9 17 4 12"/></svg></span></div>
