const headings = [
  { id: 'before-you-open',      text: 'Before you open the app' },
  { id: 'onboarding',           text: 'First launch and setup' },
  { id: 'starting-balances',    text: 'Setting starting balances' },
  { id: 'priority-colors',      text: 'How priority colors work' },
  { id: 'logging-a-transaction',text: 'Logging a transaction' },
  { id: 'budget-periods',       text: 'Budget periods' },
  { id: 'first-week',           text: 'Your first week' },
  { id: 'common-mistakes',      text: 'Common mistakes' },
  { id: 'next-steps',           text: 'Next steps' },
