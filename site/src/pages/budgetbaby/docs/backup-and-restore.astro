          <div class="dm-kv"><span>Transactions</span><strong>1,283</strong></div>
          <div class="dm-kv"><span>Budget periods</span><strong>17</strong></div>
          <div class="dm-kv"><span>Bills + subs</span><strong>14</strong></div>
        </div>
        <div class="dm-card dm-card-warn">
          <div class="dm-kv"><strong>No cloud backup yet</strong><span class="dm-pill orange">!</span></div>
