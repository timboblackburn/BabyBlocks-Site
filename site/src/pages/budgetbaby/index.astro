---
import Layout from '../../layouts/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import ScreenshotFrame from '../../components/ScreenshotFrame.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
import PhoneMockup from '../../components/abstract/PhoneMockup.astro';
import BudgetBabyPreview from '../../components/abstract/BudgetBabyPreview.astro';
import AbstractGlow from '../../components/abstract/AbstractGlow.astro';

const features = [
  {
    icon: 'target',
    title: 'Safe to Spend',
    desc: 'One number on the home screen tells you what you have left for today. If it is green, you are fine. If it is red, hold off.',
  },
  {
    icon: 'layers',
    title: 'Money Pools',
    desc: 'See your Cash, Card, and Savings as three separate buckets. So you can tell where the money is, not just the grand total.',
  },
  {
    icon: 'tag',
    title: 'Priority Categories',
    desc: 'Tag every expense as Essentials, Variable, Fun, or Unplanned. See where the month actually went, in colour, in a glance.',
  },
  {
    icon: 'file-text',
    title: 'Recurring Bills',
    desc: 'Add each bill once. We track the due date and ping you a few days early. Upcoming bills already drop out of your daily number.',
  },
  {
    icon: 'star',
    title: 'Savings Goals',
    desc: 'Pick a goal. Watch the ring fill up. The amount you set aside does not count against your daily spend.',
  },
  {
    icon: 'cloud-upload',
    title: 'Cloud Backup',
    desc: 'Optional iCloud backup, encrypted on your phone before it leaves. Phone breaks, you restore in a few taps.',
  },
  {
    icon: 'bar-chart-2',
    title: 'Insights you can use',
    desc: 'Tap any category to see every transaction inside it. Premium adds month-by-month analysis with the full breakdown on one screen.',
  },
  {
    icon: 'camera',
    title: 'Photos of receipts',
    desc: 'Snap the receipt, attach it to the transaction. Tap to view it full-screen later. One tap to delete.',
  },
  {
    icon: 'bell',
    title: 'Reminders that fit your life',
    desc: 'Pick when each bill or subscription pings you. Set quiet hours. Get a monthly nudge to top up your savings goal. (Premium.)',
  },
];

const steps = [
  {
    num: '01',
    title: 'Set it up once',
    desc: 'Tell us how often you get paid and roughly how much. The whole setup is eight short steps and takes about three minutes.',
  },
  {
    num: '02',
    title: 'Tap as you go',
    desc: 'Bought lunch? Open the app, tap, pick the category. Done. Back to your day.',
  },
  {
    num: '03',
    title: 'Glance and decide',
    desc: 'Considering a purchase? Open the app. Look at the number. If it is healthy, go for it. If not, you just saved yourself a problem.',
  },
];

const faqs = [
  {
    q: 'What is this Safe to Spend number?',
    a: 'It is what you have left to spend today after your upcoming bills, your savings target, and what you have already spent are taken out. Every time you log something, the number updates.',
  },
  {
    q: 'Does it know about my bank account?',
    a: 'No. We never see your bank, your statements, or your card. You type what you spend. That is the whole reason the numbers match what is actually in your account.',
  },
  {
    q: 'Does my data leave my phone?',
    a: 'Not unless you ask it to. Everything sits on your device by default. iCloud backup is optional and we encrypt your data on your phone before it goes anywhere.',
  },
  {
    q: 'What is the difference between free and premium?',
    a: 'The free version is the real app, not a demo. You get Safe to Spend, unlimited transactions, three savings goals, three recurring bills, three subscriptions, five custom categories, and one CSV export a month. Premium ($7.99 a month or $69.99 a year) drops the limits and adds calendar sync, monthly reports, PDF exports, and up to five backup slots.',
  },
  {
    q: 'What happens when the month ends?',
    a: 'The finished period gets archived (you can still look at it, just not edit it) and a new one starts. Surplus money can carry over if you want. Your Cash and Card balances always carry forward.',
  },
  {
    q: 'Can I get my data out?',
    a: 'Yes. Free users export one CSV a month. Premium gets unlimited exports in CSV and PDF, with the full breakdown and category progress bars.',
  },
  {
    q: 'Will it run on my iPhone?',
    a: 'You need iPhone with iOS 17 or later. The app is built in Swift and SwiftData, so it is iPhone-only and very fast.',
  },
];
---

<Layout
  title="BudgetBaby for iOS: Plan bills, spending, and savings"
  description="BudgetBaby is an iOS budgeting app. It plans bills, spending, and savings without connecting your bank. Free tier with optional Premium."
  canonical="/budgetbaby"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "BudgetBaby",
    "operatingSystem": "iOS 17.0+",
    "applicationCategory": "FinanceApplication",
    "offers": [
      {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "description": "Free tier with 5 custom categories, 3 bills, 3 subscriptions, and 1 monthly CSV export"
      },
      {
        "@type": "Offer",
        "price": "7.99",
        "priceCurrency": "USD",
        "description": "Premium monthly subscription"
      },
      {
        "@type": "Offer",
        "price": "69.99",
        "priceCurrency": "USD",
        "description": "Premium annual subscription with 7-day free trial"
      }
    ],
    "description": "A premium iOS budgeting app built for simplicity and clarity. Know what's safe to spend today.",
    "publisher": {
      "@type": "Organization",
      "name": "Intriguing Insight",
      "parentOrganization": {
        "@type": "Organization",
        "name": "Intrigue MMC LLC"
      }
    }
  })} />

  <!-- Hero -->
  <section class="bb-hero section">
    <AbstractGlow tone="peach" size="xl" opacity={0.30}
                  position="top:-12%; right:-8%;" class="bb-hero-glow" />
    <AbstractGlow tone="coral" size="lg" opacity={0.18}
                  position="top:30%; left:-10%;" class="bb-hero-glow" />
    <div class="container">
      <div class="hero-inner">
        <div class="hero-copy">
          <a href="#bb-waitlist" class="label-chip" aria-label="Join the waitlist">
            <span class="label-chip-dot" aria-hidden="true"></span>Join the waitlist
          </a>
          <h1 class="display-serif">Can you actually<br />afford that today?</h1>
          <p>
            BudgetBaby works it out for you. It tracks Cash, Card, and Savings as three
            buckets, then shows one number on the home screen that already accounts for your
            rent, your bills, and what you said you would save. If the number is green, go
            for it. If it is small, maybe wait a day.
          </p>
          <div class="hero-actions">
            <a href="#bb-waitlist" class="btn btn-primary btn-lg">
              Join the waitlist
            </a>
            <a href="/budgetbaby/features" class="btn btn-secondary btn-lg">
              Tour the features
            </a>
          </div>
          <p class="hero-note">iPhone, iOS 17 and up. Free to use. Premium is $7.99 a month or $69.99 a year.</p>

          <div id="bb-waitlist" class="hero-waitlist">
            <WaitlistForm
              app="budgetbaby"
              heading="Drop your email. We will email you the day it goes live."
              sub="One email, just from us. No newsletter, no marketing list."
            />
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <PhoneMockup tone="dark" width={240} tilt={-2} class="bb-hero-phone">
            <BudgetBabyPreview variant="home" />
          </PhoneMockup>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Grid -->
  <section class="features section">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">What is in it</span>
        <h2>Nine things, no fluff.</h2>
        <p>Each feature here exists because someone using the app actually needed it. If a thing did not earn its place, we cut it.</p>
      </div>

      <div class="feature-grid">
        {features.map((f) => (
          <GlassCard glow>
            <div class="feature-item">
              <div class="feature-icon"><Icon name={f.icon} size={28} /></div>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </div>
          </GlassCard>
        ))}
      </div>

      <div class="features-link-row">
        <a href="/budgetbaby/features" class="btn btn-secondary">
          See every feature →
        </a>
      </div>
    </div>
  </section>

  <!-- Screenshot Showcase -->
  <section class="screenshots-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">A peek inside</span>
        <h2>Three screens, three answers.</h2>
        <p>How much can I spend today, where is my money sitting, and where did it all go this month.</p>
      </div>

      <div class="screenshots-grid">
        <ScreenshotFrame caption="Know your number" label="Safe to Spend">
          <div class="mock-screen-sts">
            <div class="ss-label">Safe to Spend Today</div>
            <div class="ss-amount green">$42<span>.50</span></div>
            <div class="ss-bar"><div class="ss-bar-fill" style="width:62%"></div></div>
            <div class="ss-row"><span>Period budget</span><span>$1,800</span></div>
            <div class="ss-row"><span>Bills reserved</span><span class="red">-$320</span></div>
            <div class="ss-row"><span>Savings reserved</span><span class="muted">-$150</span></div>
            <div class="ss-row bold"><span>Left to spend</span><span class="green">$1,330</span></div>
          </div>
        </ScreenshotFrame>

        <ScreenshotFrame caption="Where the money sits" label="Money Pools">
          <div class="mock-screen-pools">
            <div class="ss-label">Your Pools</div>
            <div class="ss-pool-row">
              <span class="ss-pool-dot cash"></span>
              <span class="ss-pool-name">Cash</span>
              <span class="ss-pool-bar-wrap"><div class="ss-pool-bar" style="width:15%"></div></span>
              <span class="ss-pool-amt">$124</span>
            </div>
            <div class="ss-pool-row">
              <span class="ss-pool-dot debit"></span>
              <span class="ss-pool-name">Card</span>
              <span class="ss-pool-bar-wrap"><div class="ss-pool-bar" style="width:78%"></div></span>
              <span class="ss-pool-amt">$1,720</span>
            </div>
            <div class="ss-pool-row">
              <span class="ss-pool-dot credit"></span>
              <span class="ss-pool-name">Savings</span>
              <span class="ss-pool-bar-wrap"><div class="ss-pool-bar" style="width:80%"></div></span>
              <span class="ss-pool-amt">$3,200</span>
            </div>
            <div class="ss-divider"></div>
            <div class="ss-row bold"><span>Total</span><span class="green">$5,044</span></div>
          </div>
        </ScreenshotFrame>

        <ScreenshotFrame caption="Where it all went" label="Spending Trends">
          <div class="mock-screen-insights">
            <div class="ss-label">Spending by Category</div>
            <div class="ss-chart">
              <div class="ss-bar-group">
                <div class="ss-bar-vert" style="height:80%"></div>
                <div class="ss-bar-label">Jan</div>
              </div>
              <div class="ss-bar-group">
                <div class="ss-bar-vert" style="height:55%"></div>
                <div class="ss-bar-label">Feb</div>
              </div>
              <div class="ss-bar-group">
                <div class="ss-bar-vert active" style="height:65%"></div>
                <div class="ss-bar-label">Mar</div>
              </div>
            </div>
            <div class="ss-cat-row">
              <span class="ss-cat-dot critical"></span>
              <span class="ss-cat-name">Essentials</span>
              <span class="ss-cat-amt">$640</span>
            </div>
            <div class="ss-cat-row">
              <span class="ss-cat-dot important"></span>
              <span class="ss-cat-name">Variable</span>
              <span class="ss-cat-amt">$310</span>
            </div>
            <div class="ss-cat-row">
              <span class="ss-cat-dot discretionary"></span>
              <span class="ss-cat-name">Fun</span>
              <span class="ss-cat-amt">$175</span>
            </div>
          </div>
        </ScreenshotFrame>
      </div>
    </div>
  </section>

  <!-- Free vs Premium -->
  <section class="pricing-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">Pricing</span>
        <h2>Free works. Premium does more.</h2>
        <p>The free tier is a working budgeting app. Premium removes limits and adds reports, calendar sync, and unlimited categories.</p>
      </div>

      <div class="pricing-table-wrap glass">
        <table class="pricing-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th>Free</th>
              <th class="premium-col">Premium</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Safe to Spend</td>
              <td class="check">Yes</td>
              <td class="check">Yes</td>
            </tr>
            <tr>
              <td>Transactions</td>
              <td>Unlimited</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Money Pools (Cash, Card, Savings)</td>
              <td class="check">Yes</td>
              <td class="check">Yes</td>
            </tr>
            <tr>
              <td>Priority Categories</td>
              <td class="check">Yes</td>
              <td class="check">Yes</td>
            </tr>
            <tr>
              <td>Custom Categories</td>
              <td>5</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Savings Goals</td>
              <td>3</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Recurring Bills</td>
              <td>3</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Subscriptions</td>
              <td>3</td>
              <td>Unlimited</td>
            </tr>
            <tr>
              <td>Data Export</td>
              <td>1/mo CSV</td>
              <td>Unlimited CSV + PDF</td>
            </tr>
            <tr>
              <td>Cloud Backup Slots</td>
              <td>1</td>
              <td>5</td>
            </tr>
            <tr>
              <td>Bill Reminders</td>
              <td>1 day before</td>
              <td>1, 3, or 7 days</td>
            </tr>
            <tr>
              <td>Subscription Reminders</td>
              <td>1 day before</td>
              <td>Custom messages + quiet hours</td>
            </tr>
            <tr>
              <td>Receipt Attachments</td>
              <td class="check">Yes</td>
              <td class="check">Yes</td>
            </tr>
            <tr>
              <td>Insights Drill-Downs</td>
              <td>Category view</td>
              <td>Full month analysis</td>
            </tr>
            <tr>
              <td>Advanced Insights + Trends</td>
              <td class="dash"></td>
              <td class="check">Yes</td>
            </tr>
            <tr>
              <td>Calendar Sync</td>
              <td class="dash"></td>
              <td class="check">Yes</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="pricing-note">
        Premium is $7.99/month or $69.99/year. The annual plan includes a 7 day free trial. Manage and cancel in iOS Settings.
      </p>
    </div>
  </section>

  <!-- How it Works -->
  <section class="how-it-works section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">How it works</span>
        <h2>Three steps.</h2>
      </div>

      <div class="steps-grid">
        {steps.map((s) => (
          <div class="step glass">
            <span class="step-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust paragraph -->
  <section class="designed-for section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="designed-inner">
          <h2>What BudgetBaby does not do.</h2>
          <p>
            It does not connect to your bank. It does not predict the future. It does not auto categorise.
            You enter what you spend. The app calculates Safe to Spend from there.
          </p>
          <p>
            Built by <strong>Intriguing Insight</strong>, an Intrigue MMC LLC studio. Independently funded.
            Subscription revenue only. No ads.
          </p>
          <a href="/about" class="btn btn-ghost" style="margin-top: var(--space-2);">
            About BabyBlocks <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-section section">
    <div class="container-sm">
      <div class="section-header">
        <span class="eyebrow">FAQ</span>
        <h2>Common questions.</h2>
      </div>

      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item glass" name="faq">
            <summary class="faq-question">
              <span>{item.q}</span>
              <svg class="faq-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))}
      </div>

      <p class="faq-footer">
        Still have questions? <a href="/budgetbaby/support">Contact support</a> or read the <a href="/budgetbaby/documentation">documentation</a>.
      </p>
    </div>
  </section>

  <CTASection
    heading="One email when BudgetBaby is live."
    subheading="Join the waitlist and we'll email you the day it goes live on the App Store."
    primaryLabel="Join the waitlist"
    primaryHref="#bb-waitlist"
    secondaryLabel="See the features"
    secondaryHref="/budgetbaby/features"
  />
</Layout>

<style>
  /* Hero */
  .bb-hero {
    position: relative;
    padding-top: calc(var(--space-20) + var(--space-8));
    isolation: isolate;
    overflow: hidden;
  }
  .bb-hero :global(.bb-hero-glow) { z-index: -1; }
  .bb-hero :global(.bb-hero-phone) { margin-inline: auto; }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero-copy h1 {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    letter-spacing: -0.03em;
  }

  .hero-copy p {
    font-size: var(--text-lg);
    max-width: 48ch;
  }

  .hero-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .hero-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin: 0;
  }

  .hero-note--callout {
    font-size: var(--text-sm);
    color: var(--ink-800);
    background: rgba(255, 255, 255, 0.7);
    border-left: 2px solid var(--coral-500);
    padding: 0.7rem 0.95rem;
    border-radius: 0.4rem;
    margin: 0.75rem 0;
    box-shadow: var(--shadow-sm);
  }

  .hero-waitlist {
    margin-top: var(--space-6);
    max-width: 32rem;
    scroll-margin-top: 6rem;
  }

  /* Phone mockup, a deliberate dark-on-cream island, like the reference. */
  .phone-mockup {
    border-radius: var(--radius-2xl);
    padding: var(--space-6);
    background: linear-gradient(180deg, #131217 0%, #0E0D12 100%);
    border: 1px solid rgba(255, 247, 239, 0.08);
    color: #FFF7EF;
    box-shadow:
      0 24px 60px rgba(60, 30, 20, 0.18),
      0 6px 18px rgba(60, 30, 20, 0.10);
  }
  .phone-mockup .mock-label { color: rgba(255, 247, 239, 0.55); }
  .phone-mockup .mock-amount { color: var(--peach-200); }
  .phone-mockup .mock-pool { color: rgba(255, 247, 239, 0.78); }
  .phone-mockup .mock-pool-icon { color: rgba(255, 247, 239, 0.50); }
  .phone-mockup .mock-pool-amount { color: #FFF7EF; }
  .phone-mockup .mock-bar {
    background: rgba(255, 247, 239, 0.10);
  }
  .phone-mockup .mock-pools { border-top-color: rgba(255, 247, 239, 0.08); }

  .safe-to-spend-mock {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mock-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .mock-amount {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--green);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .mock-cents { font-size: 2rem; opacity: 0.7; }

  .mock-bar {
    height: 6px;
    background: rgba(255,255,255,0.08);
    border-radius: 3px;
    overflow: hidden;
  }

  .mock-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--purple-500), var(--purple-400));
    border-radius: 3px;
  }

  .mock-pools {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--glass-border);
  }

  .mock-pool {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .mock-pool-icon {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .mock-pool-amount {
    margin-left: auto;
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  /* Features */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .feature-icon {
    color: var(--accent-light);
    line-height: 1;
    width: var(--icon-lg, 28px);
    height: var(--icon-lg, 28px);
  }

  .feature-item h3 {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .feature-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .features-link-row {
    margin-top: var(--space-10);
    display: flex;
    justify-content: center;
  }

  /* Steps */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .step {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step-num {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    color: var(--accent-light);
    letter-spacing: 0.06em;
  }

  .step h3 { font-size: var(--text-xl); }

  .step p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* Designed for */
  .designed-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .designed-inner h2 { font-size: var(--text-2xl); }
