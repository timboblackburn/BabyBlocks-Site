---
import Layout from '../../layouts/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';

// KB article detail. Static prerender, getStaticPaths fetches the full
// article list from the platform at build time and one page is generated
// per article. Each article's body is rendered from the seeded Markdown.

const kbListUrl =
  import.meta.env.PUBLIC_KB_LIST_URL ??
  'https://api.babyblocks.io/api/public/kb';
const kbDetailUrl =
  import.meta.env.PUBLIC_KB_DETAIL_URL ??
  'https://api.babyblocks.io/api/public/kb';

interface KBArticleDetail {
  slug: string;
  title: string;
  summary: string;
  category: string;
  body: string;
}

interface KBSummary {
  slug: string;
  title: string;
  summary: string;
  category: string;
}

export async function getStaticPaths() {
  const listUrl = import.meta.env.PUBLIC_KB_LIST_URL ?? 'https://api.babyblocks.io/api/public/kb';
  const detailUrl = import.meta.env.PUBLIC_KB_DETAIL_URL ?? 'https://api.babyblocks.io/api/public/kb';

  let summaries: KBSummary[] = [];
  try {
    const res = await fetch(listUrl);
    if (res.ok) {
      const data = await res.json() as { articles?: KBSummary[] };
      summaries = data.articles ?? [];
    }
  } catch (err) {
    console.error('[help/[slug]] List fetch failed:', err);
    return [];
  }

  // Fetch each article's full body in parallel
  const details = await Promise.all(
    summaries.map(async (s): Promise<KBArticleDetail | null> => {
      try {
        const res = await fetch(`${detailUrl}/${s.slug}`);
        if (!res.ok) return null;
        return await res.json() as KBArticleDetail;
      } catch {
        return null;
      }
    }),
  );

  return details
    .filter((a): a is KBArticleDetail => a !== null)
    .map((article) => ({
      params: { slug: article.slug },
      props: { article, allArticles: summaries },
    }));
}

interface Props {
  article: KBArticleDetail;
  allArticles: KBSummary[];
}

const { article, allArticles } = Astro.props as Props;

// Tiny Markdown-to-HTML renderer, handles the subset our KB articles use:
// # / ## / ### headings, paragraphs, **bold**, *italic*, `inline code`,
// - / 1. lists, [text](url) links. No HTML escape because content is
// operator-authored.
function renderMarkdown(md: string): string {
  const lines = md.split('\n');
  const out: string[] = [];
  let inList: 'ul' | 'ol' | null = null;

  function inline(text: string): string {
    return text
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(?<![\*])\*([^*]+)\*(?![\*])/g, '<em>$1</em>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
  }

  function closeList() {
    if (inList) { out.push(`</${inList}>`); inList = null; }
  }

  for (const raw of lines) {
    const line = raw.trim();
    if (!line) { closeList(); continue; }

    let m;
    if ((m = line.match(/^(#{1,3})\s+(.*)$/))) {
      closeList();
      const lvl = m[1].length;
      out.push(`<h${lvl + 1}>${inline(m[2])}</h${lvl + 1}>`);
      continue;
    }
    if ((m = line.match(/^[-*]\s+(.*)$/))) {
      if (inList !== 'ul') { closeList(); out.push('<ul>'); inList = 'ul'; }
      out.push(`<li>${inline(m[1])}</li>`);
      continue;
    }
    if ((m = line.match(/^\d+\.\s+(.*)$/))) {
      if (inList !== 'ol') { closeList(); out.push('<ol>'); inList = 'ol'; }
      out.push(`<li>${inline(m[1])}</li>`);
      continue;
    }
    closeList();
    out.push(`<p>${inline(line)}</p>`);
  }
  closeList();
  return out.join('\n');
}

const bodyHtml = renderMarkdown(article.body ?? '');

// Related: same category, exclude self, limit 4
const related = allArticles
  .filter((a) => a.category === article.category && a.slug !== article.slug)
  .slice(0, 4);
---

<Layout
  title={`${article.title} | BabyBlocks Help`}
  description={article.summary}
  canonical={`/help/${article.slug}`}
  theme="core"
>
  <section class="kb-detail section">
    <div class="container container-narrow">
      <a href="/help" class="kb-back">← All articles</a>
      <h1 class="kb-title">{article.title}</h1>
      <p class="kb-summary">{article.summary}</p>
      <article class="kb-body" set:html={bodyHtml} />

      {related.length > 0 && (
        <div class="kb-related">
          <h2 class="kb-related-title">Related</h2>
          <ul class="kb-related-list">
            {related.map((a) => (
              <li><a href={`/help/${a.slug}`}>{a.title}</a></li>
            ))}
          </ul>
        </div>
      )}

      <div class="kb-still-stuck">
        <p>Still stuck? Reply to any email from us, or write to <a href="mailto:support@babyblocks.io">support@babyblocks.io</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container-narrow { max-width: 720px; margin: 0 auto; padding: 0 1.25rem; }

  .kb-detail { padding: 3rem 0 5rem; }

  .kb-back {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    display: inline-block;
    margin-bottom: 1.25rem;
  }
  .kb-back:hover { color: var(--text-primary); }

  .kb-title {
    font-size: 2rem;
    line-height: 1.25;
    margin: 0 0 0.75rem;
    color: var(--text-primary);
  }
  .kb-summary {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0 0 2.25rem;
  }

  .kb-body {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-primary);
  }
  .kb-body :global(h2) { font-size: 1.4rem; margin-top: 2rem; margin-bottom: 0.5rem; }
  .kb-body :global(h3) { font-size: 1.15rem; margin-top: 1.5rem; margin-bottom: 0.5rem; color: var(--text-primary); }
  .kb-body :global(h4) { font-size: 1rem; margin-top: 1.25rem; margin-bottom: 0.4rem; color: var(--text-primary); }
  .kb-body :global(p) { margin: 0.75rem 0; color: var(--text-secondary); }
  .kb-body :global(ul), .kb-body :global(ol) { margin: 0.75rem 0; padding-left: 1.5rem; color: var(--text-secondary); }
  .kb-body :global(li) { margin: 0.3rem 0; }
  .kb-body :global(strong) { color: var(--text-primary); }
  .kb-body :global(code) {
    background: rgba(255,255,255,0.07);
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }
  .kb-body :global(a) { color: var(--accent); }

  .kb-related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .kb-related-title {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin: 0 0 0.6rem;
  }
  .kb-related-list { list-style: none; padding: 0; margin: 0; }
  .kb-related-list li { padding: 0.4rem 0; }
  .kb-related-list a { color: var(--text-secondary); text-decoration: none; }
  .kb-related-list a:hover { color: var(--text-primary); }

  .kb-still-stuck {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.08);
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .kb-still-stuck a { color: var(--accent); }
</style>
