---
import Layout from '../../layouts/Layout.astro';
import GlassCard from '../../components/GlassCard.astro';
import Icon from '../../components/Icon.astro';
import AppIcon from '../../components/AppIcon.astro';
import WaitlistForm from '../../components/WaitlistForm.astro';
---

<Layout
  title="PantryBaby: Pantry and Grocery List App | BabyBlocks"
  description="PantryBaby from BabyBlocks: your grocery list and pantry memory. Track what you have, what's running low and what's expiring. Coming soon to the App Store."
  canonical="/pantrybaby"
  theme="pantry"
  product="pantrybaby"
>
  <section class="coming-hero section">
    <div class="container">
      <div class="coming-inner">
        <div class="coming-copy">
          <div class="label-chip">Coming soon to the App Store</div>
          <h1>PantryBaby</h1>
          <p class="coming-tagline">Your grocery list + pantry memory.</p>
          <p class="coming-desc">
            Never forget what you have. Never forget what you need. PantryBaby gives you a single,
            always-up-to-date view of your pantry inventory and shopping list, so you can stop
            doing that mental inventory check every time you're at the store.
          </p>

          <!-- Notify CTA -->
          <div class="notify-section" id="notify">
            <WaitlistForm
              app="pantrybaby"
              heading="Get notified at launch."
              sub="No spam. Just one email when PantryBaby hits the App Store."
            />
          </div>
        </div>

        <div class="coming-visual" aria-hidden="true">
          <div class="pantry-mock glass">
            <div class="mock-header">
              <div class="mock-app-icon"><AppIcon app="pantrybaby" size={22} /></div>
              <span class="mock-app-name">PantryBaby</span>
            </div>
            <div class="mock-status-row">
              <div class="mock-stat">
                <span class="mock-stat-val">12</span>
                <span class="mock-stat-label">On list</span>
              </div>
              <div class="mock-stat">
                <span class="mock-stat-val status-low">8</span>
                <span class="mock-stat-label">Running low</span>
              </div>
              <div class="mock-stat">
                <span class="mock-stat-val status-out">3</span>
                <span class="mock-stat-label">Out of stock</span>
              </div>
            </div>
            <div class="mock-items">
              <div class="mock-item">
                <span class="mock-item-dot dot-low"></span>
                <span>Whole milk</span>
                <span class="mock-item-loc">Refrigerator</span>
              </div>
              <div class="mock-item">
                <span class="mock-item-dot dot-out"></span>
                <span>Pasta</span>
                <span class="mock-item-loc">Pantry</span>
              </div>
              <div class="mock-item">
                <span class="mock-item-dot dot-ok"></span>
                <span>Olive oil</span>
                <span class="mock-item-loc">Kitchen</span>
              </div>
              <div class="mock-item">
                <span class="mock-item-dot dot-low"></span>
                <span>Coffee</span>
                <span class="mock-item-loc">Pantry</span>
              </div>
              <div class="mock-item">
                <span class="mock-item-dot dot-out"></span>
                <span>Paper towels</span>
                <span class="mock-item-loc">Utilities</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's coming -->
  <section class="whats-coming section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">What to expect</span>
        <h2>Built for real kitchens.</h2>
        <p>PantryBaby keeps track of what you have, tells you what is running low or about to expire, and turns that into your shopping list.</p>
      </div>

      <div class="coming-features">
        <GlassCard glow>
          <div class="cf-item">
            <div class="cf-icon"><Icon name="box" size={28} /></div>
            <h3>Pantry inventory</h3>
            <p>Track what is in your pantry, fridge and freezer with In Stock, Low and Out at a glance, plus expiry dates and reminders before things go off.</p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="cf-item">
            <div class="cf-icon"><Icon name="shopping-cart" size={28} /></div>
            <h3>Shopping list</h3>
            <p>Add items yourself or from what is running low. Check them off as you shop and they go back into your pantry.</p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="cf-item">
            <div class="cf-icon"><Icon name="refresh-cw" size={28} /></div>
            <h3>Recurring items</h3>
            <p>Set the things you buy every week or month to add themselves to your list on schedule.</p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="cf-item">
            <div class="cf-icon"><Icon name="shield" size={28} /></div>
            <h3>Sync and encrypted backups</h3>
            <p>Sign in with Apple or Google to keep your devices in step, or use PantryBaby without an account. Backups are encrypted on your phone before they are saved.</p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="cf-item">
            <div class="cf-icon"><Icon name="lock" size={28} /></div>
            <h3>Private by default</h3>
            <p>No ads, no tracking, and usage data stays off unless you turn it on. Read the <a href="/pantrybaby/privacy">privacy policy</a>.</p>
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container-sm" style="text-align:center;">
      <p>Questions? Visit <a href="https://support.babyblocks.io/?app=pantrybaby">PantryBaby support</a> or read the <a href="/pantrybaby/terms">terms</a> and <a href="/pantrybaby/privacy">privacy policy</a>.</p>
    </div>
  </section>

  <!-- BudgetBaby link -->
  <section class="bb-cta section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="bb-cta-inner">
          <div>
            <p class="bb-cta-label">Available now</p>
            <h2>Looking for the budgeting app?</h2>
            <p>BudgetBaby, the BabyBlocks flagship, is live on the App Store. Free to use, with optional Premium.</p>
            <a href="/budgetbaby" class="btn btn-primary" style="margin-top: var(--space-4);">
              Explore BudgetBaby →
            </a>
          </div>
          <div class="bb-icon" aria-hidden="true"><AppIcon app="budgetbaby" size={56} /></div>
        </div>
      </GlassCard>
    </div>
  </section>
</Layout>

<style>
  .coming-hero {
    padding-top: calc(var(--space-20) + var(--space-8));
  }

  .coming-inner {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--space-16);
    align-items: center;
  }

  .coming-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .coming-copy h1 {
    font-size: clamp(var(--text-5xl), 8vw, var(--text-7xl));
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: #3A6A5D;
  }

  .coming-tagline {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    color: var(--text-primary) !important;
    margin: 0 !important;
  }

  .coming-desc {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 50ch;
  }

  /* Notify section */
  .notify-section { display: flex; flex-direction: column; gap: var(--space-3); }

  .notify-heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
  }

  .notify-sub {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 !important;
  }

  .form-placeholder-inner {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .form-placeholder-icon {
    display: flex;
    align-items: center;
    color: var(--accent-light);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .form-placeholder-label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--text-primary) !important;
    margin-bottom: var(--space-2) !important;
  }

  .form-placeholder-note {
    font-size: var(--text-xs) !important;
    color: var(--text-muted) !important;
    line-height: var(--leading-relaxed) !important;
    margin: 0 !important;
  }

  /* Pantry mock */
  .pantry-mock {
    padding: var(--space-6);
    background: var(--surface) !important;
    border-color: var(--ink) !important;
    box-shadow: var(--shadow-block);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mock-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--text-primary);
  }

  .mock-app-icon {
    display: flex;
    align-items: center;
    color: #4A7B6E;
    flex-shrink: 0;
  }

  .mock-status-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding: var(--space-3);
    background: rgba(0,0,0,0.03);
    border-radius: var(--radius-md);
    border: 1px solid var(--glass-border);
  }

  .mock-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .mock-stat-val {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .mock-stat-val.status-low { color: var(--yellow); }
  .mock-stat-val.status-out { color: var(--red); }

  .mock-stat-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-align: center;
  }

  .mock-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: 1px solid var(--glass-border);
    padding-top: var(--space-3);
  }

  .mock-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .mock-item-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-ok  { background: var(--green); }
  .dot-low { background: var(--yellow); }
  .dot-out { background: var(--red); }

  .mock-item-loc {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  /* Coming features */
  .coming-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .cf-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cf-icon {
    display: flex;
    align-items: center;
    color: #4A7B6E;
    line-height: 1;
  }

  .cf-item h3 { font-size: var(--text-lg); }

  .cf-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* BB CTA */
  .bb-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
  }

  .bb-cta-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-2) !important;
  }

  .bb-cta-inner h2 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .bb-cta-inner > div > p { font-size: var(--text-sm); color: var(--text-secondary); margin: 0; }

  .bb-icon {
    display: flex;
    align-items: center;
    color: var(--accent-light);
    flex-shrink: 0;
    opacity: 0.4;
  }

  @media (max-width: 900px) {
    .coming-inner { grid-template-columns: 1fr; }
    .coming-visual { order: -1; max-width: 340px; }
    .coming-features { grid-template-columns: repeat(2, 1fr); }
    .bb-cta-inner { flex-direction: column; }
    .bb-icon { display: none; }
  }

  @media (max-width: 600px) {
    .coming-features { grid-template-columns: 1fr; }
  }
</style>
