---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';

// OPTION B — the online form is taken down.
//
// This page previously carried a form that posted to a compliance endpoint. It
// shipped with an empty submit target and told customers "Thanks. We got it"
// while recording their statutory request nowhere. The endpoint it was meant to
// post to (/api/compliance/babyblocks/dsr-submit) has never been built.
//
// Rather than keep a form that cannot do what it claims, this page hands the
// customer the path that actually works today: email. The page itself is kept,
// because the privacy policy links here and a 404 on the route named as THE way
// to exercise a GDPR/CCPA right would be worse than an honest page.
//
// When the compliance endpoint exists, restore the form from the previous commit
// on this branch (OPTION A) — it is written to fail closed and to claim success
// only on a 2xx — and set PUBLIC_CRM_BASE_URL in Cloudflare Pages first.
// scripts/assert-dsr-config.mjs enforces that ordering.

const SUPPORT_EMAIL = 'support@babyblocks.io';
const lastUpdated = 'September 2, 2026';

const accessBody = [
  'I am requesting a copy of the data BabyBlocks holds about me (GDPR Art. 15 / CCPA Right to Know).',
  '',
  'Email address on my account:',
  '',
  'Other email addresses I may have used with you (optional):',
  '',
  'Anything that helps you locate my records (optional):',
  '',
].join('\n');

const deletionBody = [
  'I am requesting deletion of the data BabyBlocks holds about me (GDPR Art. 17 / CCPA Right to Delete).',
  '',
  'Email address on my account:',
  '',
  'Other email addresses I may have used with you (optional):',
  '',
].join('\n');

const accessMailto =
  `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent('Data request — send me a copy of my data')}` +
  `&body=${encodeURIComponent(accessBody)}`;

const deletionMailto =
  `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent('Data request — delete my data')}` +
  `&body=${encodeURIComponent(deletionBody)}`;
---

<Layout
  title="Data request | BabyBlocks"
  description="Request a copy of, or deletion of, the data BabyBlocks holds about you. Email us and we respond within 30 days."
  canonical="/data-request"
>
  <!-- Hero -->
  <section class="sec-hero section">
    <div class="container">
      <div class="sec-hero-inner">
        <div class="label-chip">Your data</div>
        <h1>Your data, your call.<br /><span class="text-gradient">Access or delete on your terms.</span></h1>
        <p>
          You can ask us for a copy of the data we hold about you, or ask us to delete it. We respond within 30 days. There is no fee.
        </p>
        <p class="sec-updated">Last updated: {lastUpdated}</p>
      </div>
    </div>
  </section>

  <!-- How to make a request -->
  <section class="sec-section section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="sec-block">
          <div class="sec-block-icon"><Icon name="mail" size={28} /></div>
          <div>
            <h2>Make a request by email</h2>
            <p>
              Requests are handled by a person, over email. Pick the one you want below — the
              message opens pre-written, and you only need to add the email address on your
              account.
            </p>

            <div class="dsr-choices">
              <a class="dsr-choice" href={accessMailto}>
                <span class="dsr-choice-title">Send me a copy of my data</span>
                <span class="dsr-choice-sub">
                  GDPR Art. 15 / CCPA "Right to Know". You get an export of every record we have
                  linked to your email.
                </span>
              </a>

              <a class="dsr-choice" href={deletionMailto}>
                <span class="dsr-choice-title">Delete my data</span>
                <span class="dsr-choice-sub">
                  GDPR Art. 17 / CCPA "Right to Delete". We delete every record linked to your
                  email, except where law requires us to retain it (tax records, fraud history).
                </span>
              </a>
            </div>

            <p class="dsr-manual">
              Prefer to write it yourself? Email
              <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> with the subject
              <strong>"Data request"</strong>, say whether you want access, an export, or
              deletion, and include the email address on your account.
            </p>
          </div>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- What happens next -->
  <section class="sec-section section-sm">
    <div class="container-sm">
      <GlassCard padding="lg">
        <div class="sec-block">
          <div class="sec-block-icon"><Icon name="check" size={28} /></div>
          <div>
            <h2>What happens next</h2>
            <ol class="dsr-steps">
              <li>You email us the request.</li>
              <li>
                We reply to confirm the request came from you, not someone impersonating you.
                Because you wrote from the address on the account, that is usually the same reply.
              </li>
              <li>We start processing.</li>
              <li>
                Within 30 days you receive your data export by email. For deletion requests, you
                receive a confirmation that we have deleted your records.
              </li>
            </ol>
            <p class="sec-note">
              Most BabyBlocks data lives on your device or in your iCloud. We do not hold it on our
              servers. Your request covers the data we DO hold (account email, support tickets,
              purchase records).
            </p>
          </div>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- Why there is no form -->
  <section class="sec-section section-sm">
    <div class="container-sm">
      <GlassCard padding="lg">
        <div class="sec-block">
          <div class="sec-block-icon"><Icon name="mail" size={28} /></div>
          <div>
            <h2>Why there is no form here</h2>
            <p>
              There used to be one. It could not reliably record what people submitted, so we took
              it down rather than leave a form that might accept your request and lose it. Email is
              the path we can stand behind today, and it carries the same 30-day commitment.
            </p>
            <p class="sec-note">
              If you emailed a request through the old form and never heard back, please send it
              again to <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. We will treat it as
              having been made on the original date.
            </p>
          </div>
        </div>
      </GlassCard>
    </div>
  </section>
</Layout>

<style>
  .dsr-choices {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1.25rem 0 1rem;
  }
  .dsr-choice {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text-primary);
    text-decoration: none;
    box-shadow: var(--shadow-card-sm);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .dsr-choice:hover {
    border-color: var(--accent-border);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }
  .dsr-choice:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .dsr-choice-title {
    font-weight: 600;
    font-size: 1rem;
  }
  .dsr-choice-sub {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-muted);
  }
  .dsr-manual {
    font-size: 0.9rem;
  }
  .dsr-steps {
    margin: 0.5rem 0 0.75rem 1.25rem;
    padding: 0;
  }
  .dsr-steps li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .dsr-choice {
      transition: none;
    }
    .dsr-choice:hover {
      transform: none;
    }
  }
</style>
