---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import CTASection from '../components/CTASection.astro';
import { BUDGETBABY_APP_STORE_URL } from '../data/appStore';
---

<Layout
  title="Changelog | BudgetBaby"
  description="BudgetBaby is live on the App Store. Release notes appear here as updates ship."
  canonical="/changelog"
>
  <section class="changelog-hero section">
    <div class="container">
      <div class="changelog-hero-inner">
        <a href={BUDGETBABY_APP_STORE_URL} class="label-chip" target="_blank" rel="noopener" aria-label="Download on the App Store">Download on the App Store</a>
        <h1>Every release,<br /><span class="text-gradient">documented here.</span></h1>
        <p>
          BudgetBaby is live on the App Store. Changelog entries will appear here as updates
          ship. <a href={BUDGETBABY_APP_STORE_URL} target="_blank" rel="noopener">Download BudgetBaby</a>
          to get the latest version.
        </p>
      </div>
    </div>
  </section>

  <section class="changelog-body section-sm">
    <div class="container-sm">
      <GlassCard>
        <div class="cl-placeholder">
          <h2>What this page will look like</h2>
          <p>
            One entry per release. Honest about what changed and why. No filler, no padding,
            no fake patch numbers to make it look like we ship more than we do. Every entry
            will have a version number, a date, and a short list of real changes.
          </p>
          <p>
            We will keep this page short on purpose. If you want to see every fix and tweak,
            the public roadmap on the
            <a href="/coming-soon/feature-requests">feature requests page</a> is the better
            place to follow along.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <CTASection
    heading="BudgetBaby is live on the App Store."
    subheading="Download it today. Free to use, with optional Premium."
    primaryLabel="Download on the App Store"
    primaryHref={BUDGETBABY_APP_STORE_URL}
    secondaryLabel="See the features"
    secondaryHref="/budgetbaby/features"
  />
</Layout>

<style>
  .changelog-hero {
    padding-top: calc(var(--space-20) + var(--space-8));
  }

  .changelog-hero-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .changelog-hero-inner h1 {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    letter-spacing: -0.03em;
  }

  .changelog-hero-inner p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .changelog-hero-inner p a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .changelog-body { padding-block: var(--space-4); }

  .cl-placeholder {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .cl-placeholder h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--text-primary);
  }

  .cl-placeholder p {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cl-placeholder a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
