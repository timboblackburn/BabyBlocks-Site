---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import CTASection from '../components/CTASection.astro';
---

<Layout
  title="Changelog | BudgetBaby"
  description="BudgetBaby is pre-launch. The changelog starts the day it ships."
  canonical="/changelog"
>
  <section class="changelog-hero section">
    <div class="container">
      <div class="changelog-hero-inner">
        <a href="/budgetbaby#bb-waitlist" class="label-chip" aria-label="Join the waitlist">Join the waitlist</a>
        <h1>The changelog starts<br /><span class="text-gradient">on launch day.</span></h1>
        <p>
          BudgetBaby is pre-launch. There is nothing to log yet. Join the waitlist on the
          <a href="/budgetbaby#bb-waitlist">BudgetBaby page</a> and we will email you the day
          v1 ships. After that, every release will be documented here.
        </p>
      </div>
    </div>
  </section>

  <section class="changelog-body section-sm">
    <div class="container-sm">
      <GlassCard>
        <div class="cl-placeholder">
          <h2>What this page will look like</h2>
          <p>
            One entry per release. Honest about what changed and why. No filler, no padding,
            no fake patch numbers to make it look like we ship more than we do. Every entry
            will have a version number, a date, and a short list of real changes.
          </p>
          <p>
            We will keep this page short on purpose. If you want to see every fix and tweak,
            the public roadmap on the
            <a href="/coming-soon/feature-requests">feature requests page</a> is the better
            place to follow along.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <CTASection
    heading="We will tell you the day v1 ships."
    subheading="Join the waitlist for one email when BudgetBaby is live on the App Store."
    primaryLabel="Join the waitlist"
    primaryHref="/budgetbaby#bb-waitlist"
    secondaryLabel="See the features"
    secondaryHref="/budgetbaby/features"
  />
</Layout>

<style>
  .changelog-hero {
    padding-top: calc(var(--space-20) + var(--space-8));
  }

  .changelog-hero-inner {
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .changelog-hero-inner h1 {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-5xl));
    letter-spacing: -0.03em;
  }

  .changelog-hero-inner p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .changelog-hero-inner p a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .changelog-body { padding-block: var(--space-4); }

  .cl-placeholder {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .cl-placeholder h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--text-primary);
  }

  .cl-placeholder p {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .cl-placeholder a {
    color: var(--accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
