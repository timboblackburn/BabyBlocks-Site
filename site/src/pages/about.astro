---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import OrbitalField from '../components/abstract/OrbitalField.astro';
import { BUDGETBABY_APP_STORE_URL } from '../data/appStore';
import { statusFor, type StatusKey } from '../data/status';

// Statuses come from the single source of truth (src/data/status.ts), not hardcoded
// here, so a status change (e.g. PantryBaby going live) updates every surface at once.
// The status flag uses a short label; the CTA-style waitlist label lives in status.ts.
const FLAG_LABEL: Record<StatusKey, string> = {
  live: 'Live',
  appReview: 'In review',
  inBuild: 'In build',
  comingSoon: 'Coming soon',
};

const ecosystemApps = [
  {
    appIcon: 'budgetbaby' as const,
    iconColor: 'budget',
    key: 'budgetbaby',
    name: 'BudgetBaby',
    tagline: 'Know what is safe to spend today.',
    href: '/budgetbaby',
  },
  {
    appIcon: 'pantrybaby' as const,
    iconColor: 'pantry',
    key: 'pantrybaby',
    name: 'PantryBaby',
    tagline: 'Track what you have. Know what to buy.',
    href: '/pantrybaby',
  },
  {
    appIcon: null,
    iconColor: 'future',
    key: 'babyblocks-core',
    name: 'BabyBlocks Core',
    tagline: 'A shared home for the apps. Idea stage.',
    href: '/coming-soon/babyblocks-core',
  },
].map((app) => {
  const statusKey = statusFor(app.key).key;
  return {
    ...app,
    statusKey,
    statusLabel: FLAG_LABEL[statusKey],
    isLive: statusKey === 'live',
    isFuture: statusKey === 'comingSoon',
  };
});
---

<Layout
  title="About BabyBlocks"
  description="BabyBlocks is an independent iOS app studio. BudgetBaby is the first app. Download BudgetBaby on the App Store."
  canonical="/about"
  ogImage="/og/about.png"
  theme="core"
>
  <!-- Hero -->
  <section class="about-hero section">
    <OrbitalField tone="ink" size="lg" rings={5} tilt={-14} opacity={0.10}
                  position="top:-8%; right:-12%;" class="about-hero-orbit" />
    <div class="container">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <div class="label-chip"><span class="label-chip-dot" aria-hidden="true"></span>About BabyBlocks</div>
          <h1 class="display-serif">An independent iOS<br />app studio.</h1>
          <p>
            We build small iOS apps for family life, and each one sticks to a single job.
            No bank connections, nothing sold to advertisers, no quietly selling your data.
          </p>
          <p>
            BudgetBaby is out now and PantryBaby is next. We're not sitting on a roadmap of ten more apps.
          </p>
          <div class="about-hero-actions">
            <a href="/budgetbaby" class="btn btn-dark">See BudgetBaby</a>
            <a href="mailto:support@babyblocks.io" class="btn btn-secondary">Email support</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What BabyBlocks is -->
  <section class="what-section section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="what-inner">
          <h2>What is BabyBlocks?</h2>
          <p>
            BabyBlocks is a small set of iOS apps for family life. Each app does one job.
            They share a visual language but each one stands on its own. You can use one without the others.
          </p>
          <p>
            The apps are built and published by <strong>Intriguing Insight</strong>, an
            independent studio under <strong>Intrigue MMC LLC</strong>. There's no board and no
            outside money, so we can take our time and build the kind of thing we'd actually keep on our own phones.
          </p>
          <p>
            Every app on this site started because we needed it and could not find it.
            We only ship solutions to problems we have ourselves, and every one of these
            apps lives on our own phones.
          </p>
          <p>
            BudgetBaby is the first app. Download BudgetBaby on the App Store from the
            <a href="/budgetbaby">BudgetBaby page</a>. PantryBaby is next.
            No other apps are in flight right now.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- Why we built this -->
  <section class="why-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">How it's built</span>
        <h2>Three rules every app follows.</h2>
        <p>The same three, across the whole family.</p>
      </div>

      <div class="why-grid">
        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">01</div>
            <h3>Answer one question</h3>
            <p>
              BudgetBaby answers "what is safe to spend today?" PantryBaby will answer "what do I need at the store?"
              If a feature does not help answer the one question, it does not ship.
            </p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">02</div>
            <h3>You enter the data</h3>
            <p>
              BudgetBaby does not connect to your bank. You log what you spend.
              That is slower, but it is also the reason the numbers match what is actually in your account.
            </p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">03</div>
            <h3>Local first</h3>
            <p>
              Your data stays on your device. iCloud backup is optional and end to end encrypted.
              Nothing sold, no ads. The only revenue is subscriptions.
            </p>
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- Ecosystem Map -->
  <section class="ecosystem-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">Apps</span>
        <h2>Where each one stands today.</h2>
        <p>Straight status on every app. No hand-waving, no "coming next year."</p>
      </div>

      <div class="ecosystem-grid">
        {ecosystemApps.map((app) => (
          <div class={`eco-card glass ${app.isFuture ? 'eco-card--future' : ''}`}>
            <div class="eco-card-top">
              {app.appIcon
                ? <AppIcon app={app.appIcon} size={44} />
                : <div class={`eco-icon eco-icon--${app.iconColor}`}><Icon name="box" size={26} /></div>
              }
              <span class={`status-flag ${app.isLive ? 'status-flag--live' : 'status-flag--wait'}`}>
                <span class="status-flag-dot" aria-hidden="true"></span>{app.statusLabel}
              </span>
            </div>
            <h3>{app.name}</h3>
            <p>{app.tagline}</p>
            {app.href && (
              <a href={app.href} class="eco-link">
                {app.isLive ? 'Learn more →' : 'Get notified →'}
              </a>
            )}
          </div>
        ))}
      </div>

      <p class="ecosystem-note">
        Each app stands on its own. You do not need the others to get value from any one of them.
      </p>
    </div>
  </section>

  <!-- Trust & Contact -->
  <section class="trust-section section-sm">
    <div class="container-sm">
      <div class="trust-grid">
        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="lock" size={24} /></div>
            <h3>Local first</h3>
            <p>Your data stays on your phone. iCloud backup is opt in and end to end encrypted. See the <a href="/budgetbaby/privacy">Privacy Policy</a>.</p>
          </div>
        </GlassCard>

        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="mail" size={24} /></div>
            <h3>Direct support</h3>
            <p>Email <a href="mailto:support@babyblocks.io">support@babyblocks.io</a>. We read every message and reply within two business days.</p>
          </div>
        </GlassCard>

        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="map-pin" size={24} /></div>
            <h3>Open requests</h3>
            <p>Submit feature requests on the <a href="/coming-soon/feature-requests">public list</a>. Most updates start there.</p>
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- Company -->
  <section class="company-section section-sm">
    <div class="container-sm">
      <GlassCard padding="lg">
        <div class="company-inner">
          <h2>About the company</h2>
          <p>
            BabyBlocks is built and published by <strong>Intriguing Insight</strong>, an
            independent studio under <strong>Intrigue MMC LLC</strong>, based in
            Illinois. No outside investors. No newsroom. No board.
          </p>
          <p>
            The apps are sold through the App Store with subscription pricing. Revenue comes from those subscriptions.
            That is the only revenue.
          </p>
          <p>
            Questions or feedback go to <a href="mailto:support@babyblocks.io">support@babyblocks.io</a>.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <CTASection
    heading="Start with BudgetBaby."
    subheading="It's on the App Store now. Free to start, and you can grab it today."
    primaryLabel="Download on the App Store"
    primaryHref={BUDGETBABY_APP_STORE_URL}
    secondaryLabel="Read the features"
    secondaryHref="/budgetbaby/features"
  />
</Layout>

<style>
  .about-hero {
    position: relative;
    padding-top: calc(var(--space-20) + var(--space-8));
    isolation: isolate;
    overflow: hidden;
  }

  .about-hero :global(.about-hero-orbit) {
    z-index: -1;
  }

  .about-hero-inner {
    max-width: 720px;
    position: relative;
  }

  .about-hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-hero-copy h1 {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    letter-spacing: -0.03em;
  }

  .about-hero-copy p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .about-hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  /* What section */
  .what-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .what-inner h2 { font-size: var(--text-2xl); }

  .what-inner p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Why grid */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .why-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .why-num {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-light);
    letter-spacing: 0.1em;
  }

  .why-item h3 { font-size: var(--text-xl); }

  .why-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Ecosystem */
  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .eco-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .eco-card--future { opacity: 0.6; }

  .eco-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .eco-icon {
    width: 48px; height: 48px;
    border-radius: var(--radius-md);
    border: var(--border-w) solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .eco-icon--budget { background: var(--accent-dim); color: var(--accent-deep); }
  .eco-icon--pantry { background: var(--accent-dim); color: var(--accent-deep); }
  .eco-icon--future { background: var(--sand-200); color: var(--text-muted); }

  .eco-card h3 { font-size: var(--text-xl); }

  .eco-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    flex: 1;
  }

  .eco-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent-light);
    text-decoration: none;
    transition: color 0.15s;
  }

  .eco-link:hover { color: var(--purple-300); }

  .ecosystem-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    max-width: 56ch;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }

  /* Trust */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .trust-icon { color: var(--accent-light); line-height: 1; }
  .trust-item h3 { font-size: var(--text-lg); }

  .trust-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Company */
  .company-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .company-inner h2 { font-size: var(--text-2xl); }

  .company-inner p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .why-grid, .ecosystem-grid, .trust-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .about-hero-copy h1 { font-size: var(--text-4xl); }
  }
</style>
