---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
import OrbitalField from '../components/abstract/OrbitalField.astro';
import AbstractGlow from '../components/abstract/AbstractGlow.astro';

const ecosystemApps = [
  {
    appIcon: 'budgetbaby' as const,
    iconColor: 'budget',
    name: 'BudgetBaby',
    status: 'live',
    statusLabel: 'In App Review',
    tagline: 'Know what is safe to spend today.',
    href: '/budgetbaby',
  },
  {
    appIcon: 'pantrybaby' as const,
    iconColor: 'pantry',
    name: 'PantryBaby',
    status: 'soon',
    statusLabel: 'In development',
    tagline: 'Track what you have. Know what to buy.',
    href: '/coming-soon/pantrybaby',
  },
  {
    appIcon: null,
    iconColor: 'future',
    name: 'BabyBlocks Core',
    status: 'future',
    statusLabel: 'Coming soon',
    tagline: 'A shared home for the apps. Idea stage.',
    href: '/coming-soon/babyblocks-core',
  },
];
---

<Layout
  title="About BabyBlocks"
  description="BabyBlocks is an independent iOS app studio. BudgetBaby is the first app, in App Review now. PantryBaby is in development."
  canonical="/about"
  theme="core"
>
  <!-- Hero -->
  <section class="about-hero section">
    <OrbitalField tone="ink" size="lg" rings={5} tilt={-14} opacity={0.12}
                  position="top:-8%; right:-12%;" class="about-hero-orbit" />
    <AbstractGlow tone="violet" size="lg" opacity={0.16}
                  position="top:-10%; left:-8%;" class="about-hero-glow" />
    <div class="container">
      <div class="about-hero-inner">
        <div class="about-hero-copy">
          <div class="label-chip"><span class="label-chip-dot" aria-hidden="true"></span>About BabyBlocks</div>
          <h1 class="display-serif">An independent iOS<br />app studio.</h1>
          <p>
            BabyBlocks is one person and a small group of contractors building iOS apps for family life.
            Every app does one job. No bank connections, no advertising, no data sales.
          </p>
          <p>
            BudgetBaby is the first app. PantryBaby is next. There is no roadmap of ten more.
          </p>
          <div class="about-hero-actions">
            <a href="/budgetbaby" class="btn btn-dark">See BudgetBaby</a>
            <a href="mailto:support@babyblocks.io" class="btn btn-secondary">Email support</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What BabyBlocks is -->
  <section class="what-section section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="what-inner">
          <h2>What is BabyBlocks?</h2>
          <p>
            BabyBlocks is a small set of iOS apps for family life. Each app does one job.
            They share a visual language but each one stands on its own. You can use one without the others.
          </p>
          <p>
            The apps are built and published by <strong>Intriguing Insight</strong>, an Intrigue MMC LLC studio.
            Intrigue MMC is one founder and a small group of contractors. Not a holding company.
          </p>
          <p>
            BudgetBaby first launched in December 2024 and is currently in App Review under the new LLC.
            PantryBaby is in development. There are no other apps in flight right now.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- Why we built this -->
  <section class="why-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">How we build</span>
        <h2>Three rules.</h2>
        <p>The same three rules every BabyBlocks app follows.</p>
      </div>

      <div class="why-grid">
        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">01</div>
            <h3>Answer one question</h3>
            <p>
              BudgetBaby answers "what is safe to spend today?" PantryBaby will answer "what do I need at the store?"
              If a feature does not help answer the one question, it does not ship.
            </p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">02</div>
            <h3>You enter the data</h3>
            <p>
              BudgetBaby does not connect to your bank. You log what you spend.
              That is slower, but it is also the reason the numbers match what is actually in your account.
            </p>
          </div>
        </GlassCard>

        <GlassCard glow>
          <div class="why-item">
            <div class="why-num">03</div>
            <h3>Local first</h3>
            <p>
              Your data stays on your device. iCloud backup is optional and end to end encrypted.
              We do not sell data. We do not run ads. The only revenue is subscriptions.
            </p>
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- Ecosystem Map -->
  <section class="ecosystem-section section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">Apps</span>
        <h2>Where each app stands.</h2>
        <p>Honest status for each one. No vague "coming next year" language.</p>
      </div>

      <div class="ecosystem-grid">
        {ecosystemApps.map((app) => (
          <div class={`eco-card glass ${app.status === 'future' ? 'eco-card--future' : ''}`}>
            <div class="eco-card-top">
              {app.appIcon
                ? <AppIcon app={app.appIcon} size={44} />
                : <div class={`eco-icon eco-icon--${app.iconColor}`}><Icon name="box" size={26} /></div>
              }
              <span class={`eco-status eco-status--${app.status}`}>{app.statusLabel}</span>
            </div>
            <h3>{app.name}</h3>
            <p>{app.tagline}</p>
            {app.href && (
              <a href={app.href} class="eco-link">
                {app.status === 'live' ? 'Learn more →' : 'Get notified →'}
              </a>
            )}
          </div>
        ))}
      </div>

      <p class="ecosystem-note">
        Each app stands on its own. You do not need the others to get value from any one of them.
      </p>
    </div>
  </section>

  <!-- Trust & Contact -->
  <section class="trust-section section-sm">
    <div class="container-sm">
      <div class="trust-grid">
        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="lock" size={24} /></div>
            <h3>Local first</h3>
            <p>Your data stays on your phone. iCloud backup is opt in and end to end encrypted. See the <a href="/budgetbaby/privacy">Privacy Policy</a>.</p>
          </div>
        </GlassCard>

        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="mail" size={24} /></div>
            <h3>Direct support</h3>
            <p>Email <a href="mailto:support@babyblocks.io">support@babyblocks.io</a>. The founder reads every message. Reply within two business days.</p>
          </div>
        </GlassCard>

        <GlassCard>
          <div class="trust-item">
            <div class="trust-icon"><Icon name="map-pin" size={24} /></div>
            <h3>Open requests</h3>
            <p>Submit feature requests on the <a href="/coming-soon/feature-requests">public list</a>. Most updates start there.</p>
          </div>
        </GlassCard>
      </div>
    </div>
  </section>

  <!-- Company -->
  <section class="company-section section-sm">
    <div class="container-sm">
      <GlassCard padding="lg">
        <div class="company-inner">
          <h2>About the company</h2>
          <p>
            BabyBlocks is built and published by <strong>Intriguing Insight</strong>,
            an Intrigue MMC LLC studio. Intrigue MMC is one founder, based in Illinois, plus a small group of contractors.
            No outside investors. No newsroom. No board.
          </p>
          <p>
            The apps are sold through the App Store with subscription pricing. Revenue comes from those subscriptions.
            That is the only revenue.
          </p>
          <p>
            Questions or feedback go to <a href="mailto:support@babyblocks.io">support@babyblocks.io</a>.
          </p>
        </div>
      </GlassCard>
    </div>
  </section>

  <CTASection
    heading="Start with BudgetBaby."
    subheading="In App Review now. Join the waitlist for one email when it goes live."
    primaryLabel="Join the waitlist"
    primaryHref="/budgetbaby#bb-waitlist"
    secondaryLabel="Read the features"
    secondaryHref="/budgetbaby/features"
  />
</Layout>

<style>
  .about-hero {
    position: relative;
    padding-top: calc(var(--space-20) + var(--space-8));
    isolation: isolate;
    overflow: hidden;
  }

  .about-hero :global(.about-hero-orbit),
  .about-hero :global(.about-hero-glow) {
    z-index: -1;
  }

  .about-hero-inner {
    max-width: 720px;
    position: relative;
  }

  .about-hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about-hero-copy h1 {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    letter-spacing: -0.03em;
  }

  .about-hero-copy p {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 58ch;
  }

  .about-hero-actions {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  /* What section */
  .what-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .what-inner h2 { font-size: var(--text-2xl); }

  .what-inner p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Why grid */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .why-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .why-num {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--accent-light);
    letter-spacing: 0.1em;
  }

  .why-item h3 { font-size: var(--text-xl); }

  .why-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Ecosystem */
  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .eco-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .eco-card--future { opacity: 0.6; }

  .eco-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .eco-icon {
    width: 48px; height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .eco-icon--budget { background: rgba(139, 92, 246, 0.15); color: var(--accent-light); }
  .eco-icon--pantry { background: rgba(52, 211, 153, 0.12); color: var(--green); }
  .eco-icon--future { background: rgba(255,255,255,0.05); color: var(--text-muted); }

  .eco-status {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .eco-status--live {
    background: rgba(52, 211, 153, 0.15);
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.25);
  }

  .eco-status--soon {
    background: rgba(251, 191, 36, 0.12);
    color: var(--yellow);
    border: 1px solid rgba(251, 191, 36, 0.2);
  }

  .eco-status--future {
    background: var(--glass-bg);
    color: var(--text-muted);
    border: 1px solid var(--glass-border);
  }

  .eco-card h3 { font-size: var(--text-xl); }

  .eco-card p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    flex: 1;
  }

  .eco-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent-light);
    text-decoration: none;
    transition: color 0.15s;
  }

  .eco-link:hover { color: var(--purple-300); }

  .ecosystem-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    max-width: 56ch;
    margin-inline: auto;
    line-height: var(--leading-relaxed);
  }

  /* Trust */
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .trust-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .trust-icon { color: var(--accent-light); line-height: 1; }
  .trust-item h3 { font-size: var(--text-lg); }

  .trust-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Company */
  .company-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .company-inner h2 { font-size: var(--text-2xl); }

  .company-inner p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 900px) {
    .why-grid, .ecosystem-grid, .trust-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .about-hero-copy h1 { font-size: var(--text-4xl); }
  }
</style>
