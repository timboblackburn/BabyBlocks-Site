---
import Layout from '../layouts/Layout.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import AppIcon from '../components/AppIcon.astro';
---

<Layout
  title="What is Coming | BabyBlocks"
  description="What is next from BabyBlocks. PantryBaby is in development. BabyBlocks Core is at the idea stage. Honest status for each."
  canonical="/coming-soon"
  theme="core"
>
  <section class="coming-hero section">
    <div class="container">
      <div class="coming-copy">
        <div class="label-chip">What is next</div>
        <h1>What is being<br /><span class="text-gradient">built next.</span></h1>
        <p class="coming-sub">
          One app at a time. PantryBaby is in development. BabyBlocks Core is at the idea stage.
        </p>
      </div>
    </div>
  </section>

  <!-- Apps in pipeline -->
  <section class="pipeline section-sm">
    <div class="container">
      <div class="pipeline-grid">
        <!-- PantryBaby, in development -->
        <a href="/coming-soon/pantrybaby" class="pipeline-card glass pipeline-card--pantry">
          <div class="pipeline-top">
            <div class="pipeline-icon"><AppIcon app="pantrybaby" size={44} /></div>
            <span class="pipeline-status status-active">In development</span>
          </div>
          <h2>PantryBaby</h2>
          <p class="pipeline-tagline">Track what you have. Know what to buy.</p>
          <p class="pipeline-desc">
            A simple pantry log and shopping list. See what is running low at a glance.
            No bar code scans required.
          </p>
          <div class="pipeline-features">
            <span class="pf-tag">Pantry inventory</span>
            <span class="pf-tag">Shopping list</span>
            <span class="pf-tag">14 storage areas</span>
            <span class="pf-tag">Expiry tracking</span>
          </div>
          <div class="pipeline-cta">
            Read about PantryBaby <span aria-hidden="true">&rarr;</span>
          </div>
        </a>

        <!-- BabyBlocks Core, idea stage -->
        <a href="/coming-soon/babyblocks-core" class="pipeline-card glass pipeline-card--core">
          <div class="pipeline-top">
            <div class="pipeline-icon"><Icon name="home" size={32} /></div>
            <span class="pipeline-status status-planning">Coming soon</span>
          </div>
          <h2>BabyBlocks Core</h2>
          <p class="pipeline-tagline">A shared home for the apps.</p>
          <p class="pipeline-desc">
            One daily view across BudgetBaby and PantryBaby. Idea stage, not yet in development.
          </p>
          <div class="pipeline-features">
            <span class="pf-tag">Unified dashboard</span>
            <span class="pf-tag">Cross-app view</span>
            <span class="pf-tag">Home Screen widgets</span>
            <span class="pf-tag">Shared account</span>
          </div>
          <div class="pipeline-cta">
            Read the brief <span aria-hidden="true">&rarr;</span>
          </div>
        </a>
      </div>

      <p class="pipeline-note">
        That is the full list right now. Nothing else is in the pipeline.
        <a href="/coming-soon/feature-requests" target="_blank" rel="noopener noreferrer">Submit a request <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </section>

  <!-- Philosophy bridge -->
  <section class="philosophy section-sm">
    <div class="container-sm">
      <GlassCard accent padding="lg">
        <div class="philosophy-inner">
          <div class="philosophy-copy">
            <h2>One app at a time.</h2>
            <p>
              Each app answers one question. BudgetBaby answers "what is safe to spend today?"
              PantryBaby will answer "what do I need at the store?" If a feature does not help answer the
              one question, it does not ship.
            </p>
            <p>
              That is the only reason there are not more apps yet.
            </p>
          </div>
        </div>
      </GlassCard>
    </div>
  </section>

  <!-- BudgetBaby already here -->
  <section class="live-now section-sm">
    <div class="container">
      <div class="section-header centered">
        <span class="eyebrow">Already built</span>
        <h2>BudgetBaby is in App Review.</h2>
        <p>The new LLC build is in App Review now. Join the waitlist for one email when it goes live.</p>
      </div>

      <div class="live-grid">
        <GlassCard glow>
          <div class="live-item">
            <div class="live-icon"><Icon name="target" size={28} /></div>
            <h3>Safe to Spend</h3>
            <p>One daily number, after bills and savings are set aside.</p>
          </div>
        </GlassCard>
        <GlassCard glow>
          <div class="live-item">
            <div class="live-icon"><Icon name="layers" size={28} /></div>
            <h3>Money Pools</h3>
            <p>Cash, Card, and Savings as three buckets. See where the money actually lives.</p>
          </div>
        </GlassCard>
        <GlassCard glow>
          <div class="live-item">
            <div class="live-icon"><Icon name="lock" size={28} /></div>
            <h3>Local first</h3>
            <p>Your data stays on the phone. iCloud backup is optional and encrypted before it leaves.</p>
          </div>
        </GlassCard>
      </div>

      <div class="live-cta">
        <a href="/budgetbaby" class="btn btn-primary btn-lg">Read about BudgetBaby <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Roadmap teaser -->
  <section class="roadmap-teaser section-sm">
    <div class="container-sm">
      <GlassCard>
        <div class="roadmap-teaser-inner">
          <div class="roadmap-teaser-icon"><Icon name="map-pin" size={28} /></div>
          <div>
            <h3>The full roadmap.</h3>
            <p>
              Shared budgets, Android, a web dashboard, and more are on the roadmap. Each item has a
              status and a target window. None of it is committed beyond what is listed.
            </p>
            <a href="/coming-soon/roadmap" class="btn btn-secondary" style="margin-top: var(--space-4);">
              See the roadmap <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </GlassCard>
    </div>
  </section>
</Layout>

<style>
  .coming-hero {
    padding-top: calc(var(--space-24) + var(--space-8));
    padding-bottom: var(--space-12);
  }

  .coming-copy {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .coming-copy h1 {
    font-size: clamp(var(--text-4xl), 7vw, var(--text-7xl));
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
  }

  .coming-sub {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    max-width: 52ch;
  }

  /* Pipeline */
  .pipeline-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .pipeline-card {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .pipeline-card--pantry {
    border-color: rgba(74, 123, 110, 0.22);
    background: rgba(74, 123, 110, 0.07);
  }

  .pipeline-card--core {
    border-color: var(--glass-border-accent);
    background: var(--accent-dim);
    opacity: 0.88;
  }

  .pipeline-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--glow-md);
    opacity: 1;
  }

  .pipeline-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pipeline-icon { display: flex; align-items: center; color: var(--accent-light); }

  .pipeline-status {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .status-active {
    background: rgba(52, 211, 153, 0.12);
    color: var(--green);
    border: 1px solid rgba(52, 211, 153, 0.22);
  }

  .status-planning {
    background: rgba(107, 95, 199, 0.1);
    color: var(--accent);
    border: 1px solid rgba(107, 95, 199, 0.2);
  }

  .pipeline-card h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .pipeline-tagline {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--text-primary) !important;
    margin: 0 !important;
  }

  .pipeline-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .pipeline-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .pf-tag {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-full);
    color: var(--text-muted);
  }

  .pipeline-cta {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--accent);
    margin-top: var(--space-2);
  }

  .pipeline-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: center;
    line-height: var(--leading-relaxed);
  }

  /* Philosophy */
  .philosophy-inner { display: flex; flex-direction: column; gap: var(--space-4); }
  .philosophy-copy h2 { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .philosophy-copy p {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Live now */
  .live-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }

  .live-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .live-icon { display: flex; align-items: center; color: var(--accent-light); }
  .live-item h3 { font-size: var(--text-lg); }

  .live-item p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .live-cta {
    display: flex;
    justify-content: center;
  }

  .roadmap-teaser-inner {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .roadmap-teaser-icon { display: flex; align-items: center; color: var(--accent-light); flex-shrink: 0; margin-top: 2px; }

  .roadmap-teaser-inner h3 { font-size: var(--text-xl); margin-bottom: var(--space-3); }

  .roadmap-teaser-inner p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (max-width: 860px) {
    .pipeline-grid { grid-template-columns: 1fr; }
    .live-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .live-grid { grid-template-columns: 1fr; }
    .roadmap-teaser-inner { flex-direction: column; }
  }
</style>
