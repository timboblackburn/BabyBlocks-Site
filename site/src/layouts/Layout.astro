---
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  /** 'core' = BabyBlocks brand light lavender (default). 'pantry' = PantryBaby (light sage).
   *  'dark' kept for legacy callers but no longer the site default. */
  theme?: 'dark' | 'core' | 'pantry';
  /** Optional extra structured data (a serialized JSON-LD string) merged into the head. */
  structuredData?: string;
  /** When true, emits <meta name="robots" content="noindex,nofollow"> so crawlers
   *  do not index this page. Use for 404, search, draft, or auth pages. */
  noindex?: boolean;
}

const {
  title,
  description = 'BudgetBaby helps you plan bills, spending, and savings without connecting your bank. Built by BabyBlocks, an independent studio.',
  ogTitle,
  ogDescription,
  canonical,
  theme = 'core',
  structuredData,
  noindex = false,
} = Astro.props;

// Default Organization JSON-LD with parentOrganization back to Intrigue MMC.
// Identical pattern on every site in the family so Google reads them as
// one entity graph rather than four orphans.
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://babyblocks.io/#org',
      name: 'BabyBlocks',
      url: 'https://babyblocks.io',
      description:
        'A family of focused iOS apps. One job each. A BabyBlocks-family project; part of Intriguing Insight; operated by Intrigue MMC LLC.',
      parentOrganization: { '@id': 'https://intriguemmc.com/#org' },
      founder: { '@id': 'https://intriguemmc.com/#founder' },
      sameAs: ['https://intriguemmc.com', 'https://intriguinginsight.com'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://babyblocks.io/#site',
      url: 'https://babyblocks.io',
      name: 'BabyBlocks',
      publisher: { '@id': 'https://babyblocks.io/#org' },
      inLanguage: 'en-US',
    },
  ],
});

const isLight = theme === 'core' || theme === 'pantry';
const themeColor = theme === 'pantry' ? '#F4F1EA' : theme === 'core' ? '#FFF7EF' : '#0B0A0F';

const pageTitle = title.includes('BabyBlocks') ? title : `${title} | BabyBlocks`;
const ogT = ogTitle ?? pageTitle;
const ogD = ogDescription ?? description;
const siteURL = 'https://babyblocks.io';
const canonicalURL = canonical ? `${siteURL}${canonical}` : null;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={ogT} />
    <meta property="og:description" content={ogD} />
    <meta property="og:site_name" content="BabyBlocks" />

    <!-- Open Graph Image -->
    <meta property="og:image" content={`${siteURL}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogT} />
    <meta name="twitter:description" content={ogD} />
    <meta name="twitter:image" content={`${siteURL}/og-image.png`} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />


    <!-- Theme -->
    <meta name="color-scheme" content={isLight ? 'light' : 'dark'} />
    <meta name="theme-color" content={themeColor} />

    <!-- Editorial type pairing. Fraunces is the family touchpoint shared with
         intriguemmc.com and intriguinginsight.com (used on display headlines).
         Inter is the body / UI face, calm, modern, highly legible at small sizes. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,450;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Analytics. Plausible. Privacy-friendly, no cookies, GDPR-compliant. -->
    <script is:inline defer data-domain="babyblocks.io" src="https://plausible.io/js/script.js"></script>

    <!-- Structured data. Always emit Organization with parentOrganization
         pointing to Intrigue MMC LLC; pages can pass `structuredData` for
         per-page SoftwareApplication, Article, or BreadcrumbList specifics. -->
    <script is:inline type="application/ld+json" set:html={orgJsonLd}></script>
    {structuredData && <script is:inline type="application/ld+json" set:html={structuredData}></script>}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content" class="page-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
