# FoundryDesk CRM endpoints.
#
# All values are PUBLIC, they are inlined into the static build and shipped
# to every visitor's browser. The captureToken is not a hard secret; it
# identifies the brand bucket on the CRM, where the endpoint applies
# IP rate-limiting, CORS-allowlisting, and spam-checking.
#
# BabyBlocks rolls up under the IntriguingInsight studio brand in our
# hierarchy, so all three forms post to the `intriguinginsight` brand on
# the CRM. The CRM splits product lines (BudgetBaby / PantryBaby / Core)
# via the `source` and `payload.productName` fields on each lead.
#
# To obtain the captureToken:
#   1. Run FoundryDesk locally (or use the deployed CRM)
#   2. Pull the captureToken for the "intriguinginsight" brand from the DB
#   3. Set PUBLIC_CRM_LEAD_TOKEN; rebuild and redeploy
#
# Newsletter form (Bearer-authenticated):
PUBLIC_CRM_LEAD_URL="https://crm.intriguemmc.com/api/leads/intriguinginsight"
PUBLIC_CRM_LEAD_TOKEN=""

# Waitlist form (public, no token required, IP rate-limited 6/min/brand):
PUBLIC_WAITLIST_URL="https://crm.intriguemmc.com/api/waitlist/intriguinginsight"
