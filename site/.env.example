# BabyBlocks-Platform CRM endpoints.
#
# BabyBlocks has its own dedicated CRM stack — the bb-ticket-service
# Cloudflare Worker behind api.babyblocks.io. The marketing-site forms
# (waitlist + newsletter) post directly to that service. Do NOT route
# them to FoundryDesk (studio.foundry-os.io / crm.intriguemmc.com);
# that CRM is for the other brands (IntrigueMMC, IntriguingInsight,
# Foundry, ScreenForge).
#
# Both endpoints are public — no auth header, no bearer token. The
# server applies IP-based rate limiting (5/min) and a CORS allowlist.
# Override either URL at build time for staging by setting the env var.

# Newsletter form — body: { email, name?, list? }
PUBLIC_CRM_LEAD_URL="https://api.babyblocks.io/api/public/newsletter"

# Waitlist form — body: { email, name, app }
#   app ∈ { 'budgetbaby', 'pantrybaby', 'babyblocks-core' }
PUBLIC_WAITLIST_URL="https://api.babyblocks.io/api/public/waitlist"
